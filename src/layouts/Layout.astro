---
import "@fontsource-variable/cairo/wght.css";
import "@fontsource-variable/inter/wght.css";
import cairoArabicFont from "@fontsource-variable/cairo/files/cairo-arabic-wght-normal.woff2?url";
import interLatinFont from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import ThemeScript from "../components/ThemeScript.astro";
import LocaleScript from "../components/LocaleScript.astro";
import RevealScript from "../components/RevealScript.astro";
import "../styles/global.css";
import {
  getAlternateLocale,
  getLocalePath,
  getTranslations,
  localeConfig,
  type Locale,
} from "../i18n";
import { SITE_URL } from "../config/site";

interface Props {
  locale?: Locale;
  /** Page-specific title; falls back to the localized site title. */
  title?: string;
  description?: string;
  /** Set for pages that should not be indexed (e.g. 404). */
  noindex?: boolean;
}

const { locale = "ar", title, description, noindex = false } = Astro.props;

const t = getTranslations(locale);
const { dir, htmlLang } = localeConfig[locale];
const alternateLocale = getAlternateLocale(locale);
const siteUrl = Astro.site ?? SITE_URL;
const canonicalUrl = new URL(getLocalePath(locale), siteUrl).href;
const alternateUrl = new URL(getLocalePath(alternateLocale), siteUrl).href;
const defaultUrl = new URL(getLocalePath("ar"), siteUrl).href;
const ogImageUrl = new URL("/og-image.png", siteUrl).href;
const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;
const ogLocales = { ar: "ar_EG", en: "en_US" } as const;
// Preload only the font subset the page's main script needs.
const primaryFont = locale === "ar" ? cairoArabicFont : interLatinFont;
---

<html lang={htmlLang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ThemeScript />
    <LocaleScript />
    <RevealScript />
    <link rel="preload" href={primaryFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="application-name" content="Rawafid" />
    {noindex && <meta name="robots" content="noindex" />}
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonicalUrl} />
          <link rel="alternate" hreflang={htmlLang} href={canonicalUrl} />
          <link rel="alternate" hreflang={localeConfig[alternateLocale].htmlLang} href={alternateUrl} />
          <link rel="alternate" hreflang="x-default" href={defaultUrl} />
        </>
      )
    }
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content="Rawafid" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocales[locale]} />
    <meta property="og:locale:alternate" content={ogLocales[alternateLocale]} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={t.meta.ogImageAlt} />
  </head>

  <body>
    <slot />
  </body>
</html>
