---
import "../styles/global.css";

const siteName = "Rawafid";
const siteNameAr = "روافد";
const tagline = "The Operating System for E-commerce Logistics";
const description =
  "Rawafid (روافد) helps e-commerce businesses manage shipments, returns, courier integrations, and real-time tracking from one unified platform.";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteName} ({siteNameAr}) – {tagline}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content={siteName} />
    <meta property="og:title" content={`${siteName} (${siteNameAr})`} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content="website" />
  </head>

  <body class="bg-white text-slate-900">
    <slot />
  </body>
</html>
