---
import WhyRawafidSectionContent from "./react-bits/WhyRawafidSectionContent";
import { getTranslations, type Locale } from "../i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "ar";
const t = getTranslations(locale);
const { whyRawafidSection: s } = t;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: s.headline,
  description: s.subheadline,
  itemListElement: s.points.map((point, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: point.title,
    description: point.description,
  })),
};
---

<section
  id="why-rawafid"
  class="why-rawafid-section"
  aria-label={s.ariaLabel}
>
  <div class="why-rawafid-section__glow why-rawafid-section__glow--start" aria-hidden="true"></div>
  <div class="why-rawafid-section__glow why-rawafid-section__glow--end" aria-hidden="true"></div>

  <div class="container why-rawafid-section__container">
    <WhyRawafidSectionContent
      client:visible
      eyebrow={s.eyebrow}
      headline={s.headline}
      subheadline={s.subheadline}
      points={s.points}
      comparison={s.comparison}
    />
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

<style is:global>
  /* ─── Section shell ──────────────────────────────────────── */
  .why-rawafid-section {
    position: relative;
    isolation: isolate;
    padding-block: var(--space-6) var(--space-8);
    background: var(--bg-secondary);
    overflow: hidden;
  }

  [data-theme="dark"] .why-rawafid-section {
    background: var(--bg-primary);
  }

  @media (min-width: 1024px) {
    .why-rawafid-section {
      padding-block: var(--space-8) var(--space-10);
    }
  }

  .why-rawafid-section__container {
    position: relative;
    z-index: 1;
  }

  .why-section__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  @media (min-width: 1024px) {
    .why-section__inner {
      gap: var(--space-16);
    }
  }

  /* ─── Ambient glows ──────────────────────────────────────── */
  .why-rawafid-section__glow {
    position: absolute;
    width: min(28rem, 55vw);
    height: min(28rem, 55vw);
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.22;
    pointer-events: none;
  }

  .why-rawafid-section__glow--start {
    top: -18%;
    inset-inline-start: -12%;
    background: color-mix(in srgb, var(--color-accent) 16%, transparent);
  }

  .why-rawafid-section__glow--end {
    bottom: -22%;
    inset-inline-end: -10%;
    background: color-mix(in srgb, var(--color-primary) 20%, transparent);
  }

  [data-theme="dark"] .why-rawafid-section__glow {
    opacity: 0.12;
  }

  /* ─── Grid ───────────────────────────────────────────────── */
  .why-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .why-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5);
    }
  }

  @media (min-width: 1024px) {
    .why-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }
  }

  /* ─── Cards ──────────────────────────────────────────────── */
  .why-card {
    --spotlight-x: 0px;
    --spotlight-y: 0px;
    --spotlight-visible: 0;
    --spotlight-color: var(--color-primary);

    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-primary);
    background: var(--bg-primary);
    overflow: hidden;
    transition:
      border-color var(--transition-base),
      box-shadow var(--transition-base),
      transform var(--transition-base);
  }

  .why-card:hover {
    border-color: var(--color-primary-alpha-20);
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  [data-theme="dark"] .why-card {
    background: var(--bg-secondary);
  }

  [data-theme="dark"] .why-card:hover {
    border-color: color-mix(in srgb, var(--spotlight-color) 30%, var(--border-secondary));
    box-shadow: var(--shadow-lg);
  }

  .why-card--local    { --spotlight-color: #2563eb; }
  .why-card--security { --spotlight-color: #16a34a; }
  .why-card--support  { --spotlight-color: #7c3aed; }
  .why-card--ease     { --spotlight-color: #f59e0b; }
  .why-card--pricing  { --spotlight-color: #0891b2; }
  .why-card--updates  { --spotlight-color: #2563eb; }

  .why-card__spotlight {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      300px circle at var(--spotlight-x) var(--spotlight-y),
      color-mix(in srgb, var(--spotlight-color) 9%, transparent),
      transparent 70%
    );
    opacity: var(--spotlight-visible);
    transition: opacity 300ms ease;
    pointer-events: none;
    z-index: 0;
  }

  [data-theme="dark"] .why-card__spotlight {
    background: radial-gradient(
      300px circle at var(--spotlight-x) var(--spotlight-y),
      color-mix(in srgb, var(--spotlight-color) 13%, transparent),
      transparent 70%
    );
  }

  .why-card__body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--space-3);
    padding: var(--space-6);
    height: 100%;
  }

  @media (min-width: 1024px) {
    .why-card__body {
      padding: var(--space-8);
    }
  }

  .why-card__icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    flex-shrink: 0;
    margin-block-end: var(--space-1);
  }

  .why-card__icon-wrap--local    { background: rgba(37, 99, 235, 0.1);  color: #2563eb; }
  .why-card__icon-wrap--security { background: rgba(34, 197, 94, 0.1);  color: #16a34a; }
  .why-card__icon-wrap--support  { background: rgba(124, 58, 237, 0.1); color: #7c3aed; }
  .why-card__icon-wrap--ease     { background: rgba(245, 158, 11, 0.1); color: #d97706; }
  .why-card__icon-wrap--pricing  { background: rgba(6, 182, 212, 0.1);  color: #0891b2; }
  .why-card__icon-wrap--updates  { background: rgba(37, 99, 235, 0.1);  color: #1d4ed8; }

  [data-theme="dark"] .why-card__icon-wrap--local    { background: rgba(37, 99, 235, 0.15);  color: #60a5fa; }
  [data-theme="dark"] .why-card__icon-wrap--security { background: rgba(34, 197, 94, 0.15);  color: #4ade80; }
  [data-theme="dark"] .why-card__icon-wrap--support  { background: rgba(124, 58, 237, 0.15); color: #a78bfa; }
  [data-theme="dark"] .why-card__icon-wrap--ease     { background: rgba(245, 158, 11, 0.15); color: #fbbf24; }
  [data-theme="dark"] .why-card__icon-wrap--pricing  { background: rgba(6, 182, 212, 0.15);  color: #22d3ee; }
  [data-theme="dark"] .why-card__icon-wrap--updates  { background: rgba(37, 99, 235, 0.15);  color: #60a5fa; }

  .why-icon__svg {
    width: 1.375rem;
    height: 1.375rem;
  }

  .why-card__title {
    margin: 0;
    width: 100%;
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    line-height: var(--leading-snug);
    color: var(--color-gray-900);
  }

  [data-theme="dark"] .why-card__title {
    color: var(--color-gray-50);
  }

  .why-card__description {
    margin: 0;
    width: 100%;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-gray-600);
  }

  [data-theme="dark"] .why-card__description {
    color: var(--color-gray-400);
  }

  /* ─── Comparison block ───────────────────────────────────── */
  .why-comparison {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-block-start: var(--space-2);
  }

  @media (min-width: 1024px) {
    .why-comparison {
      padding-block-start: var(--space-4);
    }
  }

  .why-comparison__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
  }

  .why-comparison__headline {
    margin: 0;
    max-width: 36rem;
    font-size: clamp(var(--text-xl), 3vw, var(--text-2xl));
    font-weight: var(--font-semibold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--color-gray-900);
    text-wrap: balance;
  }

  [data-theme="dark"] .why-comparison__headline {
    color: var(--color-gray-50);
  }

  .why-comparison__panel {
    overflow-x: auto;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-primary);
    background: var(--bg-primary);
    box-shadow: var(--shadow-md);
    -webkit-overflow-scrolling: touch;
  }

  .why-comparison__panel:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  [data-theme="dark"] .why-comparison__panel {
    background: var(--bg-secondary);
    box-shadow: var(--shadow-lg);
  }

  .why-comparison__table {
    width: 100%;
    min-width: 34rem;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .why-comparison__th {
    padding: var(--space-4) var(--space-5);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: center;
    color: var(--color-gray-500);
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-primary);
  }

  .why-comparison__th--feature {
    text-align: start;
    width: 42%;
  }

  .why-comparison__th--rawafid {
    color: var(--color-primary-dark);
    background: color-mix(in srgb, var(--color-primary) 8%, var(--bg-secondary));
  }

  .why-comparison__th--traditional {
    width: 29%;
  }

  [data-theme="dark"] .why-comparison__th {
    color: var(--color-gray-400);
    background: color-mix(in srgb, var(--color-gray-800) 35%, var(--bg-secondary));
  }

  [data-theme="dark"] .why-comparison__th--rawafid {
    color: var(--color-primary-light);
    background: color-mix(in srgb, var(--color-primary) 14%, var(--bg-secondary));
  }

  .why-comparison__row {
    border-bottom: 1px solid var(--border-primary);
    transition: background-color var(--transition-base);
  }

  .why-comparison__row:last-child {
    border-bottom: none;
  }

  .why-comparison__row:hover {
    background: color-mix(in srgb, var(--color-primary) 3%, var(--bg-primary));
  }

  [data-theme="dark"] .why-comparison__row:hover {
    background: color-mix(in srgb, var(--color-primary) 6%, var(--bg-secondary));
  }

  .why-comparison__feature {
    padding: var(--space-4) var(--space-5);
    font-weight: var(--font-medium);
    text-align: start;
    color: var(--color-gray-700);
  }

  [data-theme="dark"] .why-comparison__feature {
    color: var(--color-gray-200);
  }

  .why-comparison__cell {
    padding: var(--space-4) var(--space-5);
    text-align: center;
    vertical-align: middle;
  }

  .why-comparison__cell--rawafid {
    background: color-mix(in srgb, var(--color-primary) 4%, transparent);
  }

  [data-theme="dark"] .why-comparison__cell--rawafid {
    background: color-mix(in srgb, var(--color-primary) 8%, transparent);
  }

  .why-comparison__value {
    color: var(--color-gray-600);
    font-weight: var(--font-medium);
  }

  .why-comparison__value--highlight {
    color: var(--color-gray-900);
    font-weight: var(--font-semibold);
  }

  [data-theme="dark"] .why-comparison__value {
    color: var(--color-gray-400);
  }

  [data-theme="dark"] .why-comparison__value--highlight {
    color: var(--color-gray-50);
  }

  .why-status {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-full);
  }

  .why-status--yes {
    color: var(--color-accent-dark);
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
  }

  .why-status--no {
    color: var(--color-gray-400);
    background: color-mix(in srgb, var(--color-gray-400) 12%, transparent);
  }

  [data-theme="dark"] .why-status--yes {
    color: var(--color-accent-light);
    background: color-mix(in srgb, var(--color-accent) 18%, transparent);
  }

  [data-theme="dark"] .why-status--no {
    color: var(--color-gray-500);
    background: color-mix(in srgb, var(--color-gray-600) 20%, transparent);
  }

  /* ─── Reduced motion ─────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .why-rawafid-section__glow {
      display: none;
    }

    .why-card {
      transition: none;
    }

    .why-card:hover {
      transform: none;
    }

    .why-card__spotlight {
      display: none;
    }
  }
</style>
