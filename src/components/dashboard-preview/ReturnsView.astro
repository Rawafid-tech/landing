---
import TopBar from "./TopBar.astro";
import { RETURN_STEP, initials, type DemoLocaleData } from "../../data/dashboard-demo";

interface Props {
  data: DemoLocaleData;
  panelId: string;
  tabId: string;
  hidden?: boolean;
}

const { data, panelId, tabId, hidden = false } = Astro.props;
---

<div
  id={panelId}
  class="demo-view demo-view--returns"
  role="tabpanel"
  aria-labelledby={tabId}
  tabindex="0"
  data-demo-panel="returns"
  hidden={hidden}
>
  <TopBar title={data.returnsTitle} searchPlaceholder={data.searchPlaceholder} />

  <div class="demo-view__body">
    <ul class="demo-ret-stats" role="list">
      {
        data.returnStats.map((rs) => (
          <li class={`demo-ret-stat demo-ret-stat--${rs.status}`}>
            <span class="demo-ret-stat__value">{rs.value}</span>
            <span class="demo-ret-stat__label">{rs.label}</span>
          </li>
        ))
      }
    </ul>

    <ol class="demo-card demo-ret-steps">
      {
        data.returnProgressLabels.map((label, i) => (
          <li class="demo-ret-steps__item">
            <span class="demo-ret-steps__num" aria-hidden="true">{i + 1}</span>
            {label}
          </li>
        ))
      }
    </ol>

    <div class="demo-card demo-table-card">
      <table class="demo-table">
        <thead>
          <tr>
            {data.returnColHeaders.map((h) => <th scope="col">{h}</th>)}
            <th scope="col">{data.returnProgressHeader}</th>
          </tr>
        </thead>
        <tbody>
          {
            data.returnRows.map((row, i) => {
              const step = RETURN_STEP[row.status];
              return (
                <tr>
                  <td>
                    <span class="demo-ret-ref">
                      <span class="demo-ref" dir="ltr">{row.ref}</span>
                      <span class="demo-ret-ref__ship" dir="ltr">{row.shipRef}</span>
                    </span>
                  </td>
                  <td>
                    <span class="demo-person">
                      <span class={`demo-avatar demo-avatar--${(i + 4) % 6}`} aria-hidden="true">
                        {initials(row.customer)}
                      </span>
                      {row.customer}
                    </span>
                  </td>
                  <td class="demo-table__muted">{row.reason}</td>
                  <td>
                    <span class="demo-courier">{row.courier}</span>
                  </td>
                  <td>
                    <span class={`demo-pill demo-pill--ret-${row.status}`}>{data.returnStatusLabel[row.status]}</span>
                  </td>
                  <td class="demo-table__muted">{row.date}</td>
                  <td>
                    <span class="demo-progress" aria-hidden="true">
                      {data.returnProgressLabels.map((_, s) => (
                        <Fragment>
                          <span class:list={["demo-progress__dot", s <= step && "is-done"]} />
                          {s < data.returnProgressLabels.length - 1 && (
                            <span class:list={["demo-progress__line", s < step && "is-done"]} />
                          )}
                        </Fragment>
                      ))}
                    </span>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </div>
</div>

<style is:global>
  .demo-ret-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    list-style: none;
  }

  .demo-ret-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 14px;
    border: 1px solid;
    border-radius: 14px;
  }

  .demo-ret-stat__value {
    font-size: 26px;
    font-weight: 700;
    line-height: 1.15;
  }

  .demo-ret-stat__label {
    font-size: 13px;
    font-weight: 600;
  }

  .demo-ret-stat--pending   { border-color: #fde68a; background: #fffbeb; color: #92400e; }
  .demo-ret-stat--collected { border-color: #bfdbfe; background: #eff6ff; color: #1d4ed8; }
  .demo-ret-stat--refunded  { border-color: #bbf7d0; background: #f0fdf4; color: #15803d; }

  [data-theme="dark"] .demo-ret-stat--pending   { border-color: rgb(245 158 11 / 0.3); background: rgb(245 158 11 / 0.1); color: #fbbf24; }
  [data-theme="dark"] .demo-ret-stat--collected { border-color: rgb(59 130 246 / 0.35); background: rgb(37 99 235 / 0.14); color: #93c5fd; }
  [data-theme="dark"] .demo-ret-stat--refunded  { border-color: rgb(34 197 94 / 0.3); background: rgb(34 197 94 / 0.1); color: #4ade80; }

  .demo-ret-steps {
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 10px 16px;
    list-style: none;
  }

  .demo-ret-steps__item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--dp-text-2);
  }

  .demo-ret-steps__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #2563eb;
    font-size: 11px;
    font-weight: 700;
    color: #fff;
  }

  .demo-ret-ref {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .demo-ret-ref__ship {
    font-size: 11.5px;
    color: var(--dp-muted);
  }

  .demo-progress {
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }

  .demo-progress__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--dp-border);
  }

  .demo-progress__line {
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: var(--dp-border);
  }

  .demo-progress__dot.is-done,
  .demo-progress__line.is-done {
    background: #2563eb;
  }

  [data-theme="dark"] .demo-progress__dot.is-done,
  [data-theme="dark"] .demo-progress__line.is-done {
    background: #60a5fa;
  }
</style>
