---
import Icon from "./Icon.astro";

interface Props {
  title: string;
  subtitle?: string;
  searchPlaceholder?: string;
  createBtn?: string;
  /** Marks the create button so a hotspot can point at it. */
  createId?: string;
}

const { title, subtitle, searchPlaceholder, createBtn, createId } = Astro.props;
---

<div class="demo-topbar">
  <div class="demo-topbar__titles">
    <span class="demo-topbar__title">{title}</span>
    {subtitle && <span class="demo-topbar__subtitle">{subtitle}</span>}
  </div>

  <div class="demo-topbar__actions" aria-hidden="true">
    {
      searchPlaceholder && (
        <span class="demo-topbar__search">
          <Icon name="search" size={14} />
          {searchPlaceholder}
        </span>
      )
    }
    <span class="demo-topbar__bell">
      <Icon name="bell" size={16} />
      <span class="demo-topbar__bell-count">3</span>
    </span>
    {
      createBtn && (
        <span class="demo-topbar__create" id={createId}>
          <Icon name="plus" size={14} strokeWidth={2.5} />
          {createBtn}
        </span>
      )
    }
  </div>
</div>

<style is:global>
  .demo-topbar {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 60px;
    padding-inline: 20px;
    border-block-end: 1px solid var(--dp-border);
    background: var(--dp-surface);
  }

  .demo-topbar__titles {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 2px;
  }

  .demo-topbar__title {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--dp-text);
  }

  .demo-topbar__subtitle {
    font-size: 12px;
    color: var(--dp-muted);
  }

  .demo-topbar__actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .demo-topbar__search {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: 220px;
    height: 36px;
    padding-inline: 12px;
    border: 1px solid var(--dp-border);
    border-radius: 9px;
    background: var(--dp-bg);
    font-size: 13px;
    color: var(--dp-muted);
  }

  .demo-topbar__bell {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--dp-border);
    border-radius: 9px;
    background: var(--dp-surface);
    color: var(--dp-text-2);
  }

  .demo-topbar__bell-count {
    position: absolute;
    inset-block-start: -5px;
    inset-inline-end: -5px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 17px;
    height: 17px;
    padding-inline: 4px;
    border: 2px solid var(--dp-surface);
    border-radius: 999px;
    background: #dc2626;
    font-size: 9.5px;
    font-weight: 700;
    color: #fff;
  }

  .demo-topbar__create {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding-inline: 14px;
    border-radius: 9px;
    background: #2563eb;
    font-size: 13px;
    font-weight: 600;
    color: #fff;
    white-space: nowrap;
    box-shadow: 0 4px 12px -4px rgb(37 99 235 / 0.5);
  }
</style>
