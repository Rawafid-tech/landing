---
import { getImage } from "astro:assets";
import lightLogoSrc from "../assets/main-logo-light.webp";
import darkLogoSrc from "../assets/main-logo-dark.webp";
import { getLocalePath, getTranslations, type Locale } from "../i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "ar";
const t = getTranslations(locale);
const { footerSection: f, meta } = t;
const homeHref = getLocalePath(locale);
const siteUrl = Astro.site ?? "https://rawafid.app";
const copyrightText = f.legal.copyright.replace("{year}", String(new Date().getFullYear()));

const logoWidths = [110, 220] as const;

const lightLogoImages = await Promise.all(
  logoWidths.map((width) =>
    getImage({
      src: lightLogoSrc,
      width,
      height: Math.round(width / (lightLogoSrc.width / lightLogoSrc.height)),
      format: "webp",
      quality: 82,
    }),
  ),
);

const darkLogoImages = await Promise.all(
  logoWidths.map((width) =>
    getImage({
      src: darkLogoSrc,
      width,
      height: Math.round(width / (darkLogoSrc.width / darkLogoSrc.height)),
      format: "webp",
      quality: 82,
    }),
  ),
);

const lightLogoSrcSet = lightLogoImages
  .map((image, index) => `${image.src} ${logoWidths[index]}w`)
  .join(", ");
const lightLogoFallback = lightLogoImages[0];

const darkLogoSrcSet = darkLogoImages
  .map((image, index) => `${image.src} ${logoWidths[index]}w`)
  .join(", ");
const darkLogoFallback = darkLogoImages[0];

const logoSizes = `${logoWidths[0]}px`;
const logoUrl = new URL(lightLogoFallback.src, siteUrl).href;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      name: "Rawafid",
      alternateName: locale === "ar" ? "روافد" : undefined,
      url: siteUrl,
      logo: {
        "@type": "ImageObject",
        url: logoUrl,
      },
      description: meta.description,
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "customer support",
        email: f.contact.email.value,
        telephone: f.contact.phone.value,
        areaServed: "EG",
        availableLanguage: ["Arabic", "English"],
      },
      address: {
        "@type": "PostalAddress",
        addressLocality: f.contact.address.value,
        addressCountry: "EG",
      },
      sameAs: f.social.links.map((link) => link.href),
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: "Rawafid",
      publisher: { "@id": `${siteUrl}/#organization` },
      inLanguage: locale === "ar" ? "ar-EG" : "en-US",
    },
  ],
};

const externalLinkProps = {
  rel: "noopener noreferrer",
  target: "_blank",
} as const;

const externalHint = locale === "ar" ? " (يفتح في نافذة جديدة)" : " (opens in a new tab)";
---

<footer
  id="contact"
  class="footer-section"
  role="contentinfo"
  aria-label={f.ariaLabel}
>
  <div class="footer-section__glow footer-section__glow--start" aria-hidden="true"></div>
  <div class="footer-section__glow footer-section__glow--end" aria-hidden="true"></div>
  <div class="footer-section__topline" aria-hidden="true"></div>

  <div class="container footer-section__container">
    <div class="footer-section__grid">
      <!-- Brand -->
      <div class="footer-section__brand">
        <a
          href={homeHref}
          class="footer-section__logo-link"
          aria-label={t.nav.logoAriaLabel}
        >
          <img
            src={lightLogoFallback.src}
            srcset={lightLogoSrcSet}
            sizes={logoSizes}
            alt={t.nav.logoAlt}
            width={lightLogoFallback.attributes.width}
            height={lightLogoFallback.attributes.height}
            loading="lazy"
            decoding="async"
            class="footer-section__logo-image footer-section__logo-image--light"
          />
          <img
            src={darkLogoFallback.src}
            srcset={darkLogoSrcSet}
            sizes={logoSizes}
            alt={t.nav.logoAlt}
            width={darkLogoFallback.attributes.width}
            height={darkLogoFallback.attributes.height}
            loading="lazy"
            decoding="async"
            class="footer-section__logo-image footer-section__logo-image--dark"
          />
        </a>
        <p class="footer-section__tagline">{f.tagline}</p>
      </div>

      <!-- Link columns -->
      {
        f.columns.map((column) => (
          <nav
            class="footer-section__column"
            aria-labelledby={`footer-${column.id}-heading`}
          >
            <h2 id={`footer-${column.id}-heading`} class="footer-section__column-title">
              {column.title}
            </h2>
            <ul class="footer-section__link-list" role="list">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="footer-section__link"
                    aria-label={link.ariaLabel ?? link.label}
                    {...(link.external ? externalLinkProps : {})}
                  >
                    {link.label}
                    {link.external ? (
                      <span class="visually-hidden">{externalHint}</span>
                    ) : null}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <!-- Contact -->
      <div class="footer-section__column footer-section__column--contact">
        <h2 id="footer-contact-heading" class="footer-section__column-title">
          {f.contact.title}
        </h2>
        <ul class="footer-section__contact-list" role="list">
          <li class="footer-section__contact-item">
            <span class="footer-section__contact-icon" aria-hidden="true">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
                ></path>
              </svg>
            </span>
            <div class="footer-section__contact-body">
              <span class="footer-section__contact-label">{f.contact.email.label}</span>
              <a
                href={f.contact.email.href}
                class="footer-section__link footer-section__link--contact"
                aria-label={f.contact.email.ariaLabel}
              >
                {f.contact.email.value}
              </a>
            </div>
          </li>
          <li class="footer-section__contact-item">
            <span class="footer-section__contact-icon" aria-hidden="true">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"
                ></path>
              </svg>
            </span>
            <div class="footer-section__contact-body">
              <span class="footer-section__contact-label">{f.contact.phone.label}</span>
              <a
                href={f.contact.phone.href}
                class="footer-section__link footer-section__link--contact"
                aria-label={f.contact.phone.ariaLabel}
              >
                {f.contact.phone.value}
              </a>
            </div>
          </li>
          <li class="footer-section__contact-item">
            <span class="footer-section__contact-icon" aria-hidden="true">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
                ></path>
              </svg>
            </span>
            <div class="footer-section__contact-body">
              <span class="footer-section__contact-label">{f.contact.address.label}</span>
              <p class="footer-section__contact-value">{f.contact.address.value}</p>
            </div>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="footer-section__bottom">
      <nav class="footer-section__social" aria-label={f.social.ariaLabel}>
        <ul class="footer-section__social-list" role="list">
          {
            f.social.links.map((social) => (
              <li>
                <a
                  href={social.href}
                  class="footer-section__social-link"
                  aria-label={social.label}
                  {...externalLinkProps}
                >
                  {social.id === "linkedin" && (
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.062 2.062 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                    </svg>
                  )}
                  {social.id === "facebook" && (
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                    </svg>
                  )}
                  {social.id === "x" && (
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                    </svg>
                  )}
                  {social.id === "instagram" && (
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                    </svg>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="footer-section__meta">
        <p class="footer-section__copyright">{copyrightText}</p>
        <nav class="footer-section__legal" aria-label={f.legal.navAriaLabel}>
          <ul class="footer-section__legal-list" role="list">
            <li>
              <a
                href={f.legal.privacy.href}
                class="footer-section__link"
                aria-label={f.legal.privacy.ariaLabel}
                {...externalLinkProps}
              >
                {f.legal.privacy.label}
              </a>
            </li>
            <li class="footer-section__legal-separator" aria-hidden="true"></li>
            <li>
              <a
                href={f.legal.terms.href}
                class="footer-section__link"
                aria-label={f.legal.terms.ariaLabel}
                {...externalLinkProps}
              >
                {f.legal.terms.label}
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </div>
  </div>

  <a
    href="#main-content"
    data-footer-back-to-top
    hidden
    aria-hidden="true"
    tabindex="-1"
    class="footer-section__back-to-top"
  >
    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75 12 8.25l7.5 7.5"></path>
    </svg>
    <span>{f.backToTop}</span>
  </a>
</footer>

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

<script>
  function setupFooterBackToTop(): (() => void) | undefined {
    const button = document.querySelector<HTMLAnchorElement>("[data-footer-back-to-top]");
    if (!button) return undefined;

    const threshold = 480;
    let rafId = 0;
    let isVisible = false;

    const setVisible = (next: boolean) => {
      if (next === isVisible) return;
      isVisible = next;
      button.toggleAttribute("hidden", !next);
      button.toggleAttribute("data-visible", next);
      button.setAttribute("aria-hidden", String(!next));
      button.tabIndex = next ? 0 : -1;
    };

    const update = () => {
      rafId = 0;
      setVisible(window.scrollY > threshold);
    };

    const onScroll = () => {
      if (rafId) return;
      rafId = window.requestAnimationFrame(update);
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    update();

    return () => {
      window.removeEventListener("scroll", onScroll);
      if (rafId) window.cancelAnimationFrame(rafId);
    };
  }

  let cleanupBackToTop = setupFooterBackToTop();

  document.addEventListener("astro:before-swap", () => {
    cleanupBackToTop?.();
    cleanupBackToTop = undefined;
  });

  document.addEventListener("astro:page-load", () => {
    cleanupBackToTop?.();
    cleanupBackToTop = setupFooterBackToTop();
  });
</script>

<style is:global>
  /* ── Section shell ─────────────────────────────────────────── */
  .footer-section {
    position: relative;
    isolation: isolate;
    padding-block: var(--space-12) var(--space-10);
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-secondary) 96%, var(--color-primary) 4%) 0%,
        var(--color-secondary) 100%
      );
    color: var(--color-gray-400);
    overflow: hidden;
  }

  [data-theme="dark"] .footer-section {
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--bg-dark) 88%, var(--color-primary) 12%) 0%,
        var(--bg-dark) 100%
      );
  }

  @media (min-width: 1024px) {
    .footer-section {
      padding-block: var(--space-16) var(--space-12);
    }
  }

  .footer-section__container {
    position: relative;
    z-index: 1;
  }

  .footer-section__topline {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      color-mix(in srgb, var(--color-primary) 45%, transparent) 50%,
      transparent 100%
    );
    pointer-events: none;
  }

  /* ── Ambient glows ─────────────────────────────────────────── */
  .footer-section__glow {
    position: absolute;
    width: min(28rem, 50vw);
    height: min(28rem, 50vw);
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.16;
    pointer-events: none;
  }

  .footer-section__glow--start {
    top: -30%;
    inset-inline-start: -10%;
    background: color-mix(in srgb, var(--color-primary) 24%, transparent);
  }

  .footer-section__glow--end {
    bottom: -35%;
    inset-inline-end: -8%;
    background: color-mix(in srgb, var(--color-accent) 18%, transparent);
  }

  [data-theme="dark"] .footer-section__glow {
    opacity: 0.1;
  }

  /* ── Main grid ─────────────────────────────────────────────── */
  .footer-section__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-10);
  }

  @media (min-width: 640px) {
    .footer-section__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-8) var(--space-10);
    }

    .footer-section__brand {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .footer-section__grid {
      grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr)) minmax(0, 1.25fr);
      gap: var(--space-8) var(--space-10);
      align-items: start;
    }

    .footer-section__brand {
      grid-column: auto;
    }
  }

  /* ── Brand ─────────────────────────────────────────────────── */
  .footer-section__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 20rem;
  }

  .footer-section__logo-link {
    display: inline-flex;
    width: fit-content;
    padding: var(--space-2) var(--space-3);
    border: 1px solid color-mix(in srgb, var(--color-white) 8%, transparent);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-white) 96%, transparent);
    box-shadow: var(--shadow-sm);
  }

  .footer-section__logo-link:hover,
  .footer-section__logo-link:focus-visible {
    color: inherit;
  }

  .footer-section__logo-link:focus-visible {
    outline: 2px solid var(--color-primary-light);
    outline-offset: 4px;
  }

  .footer-section__logo-image {
    width: auto;
    height: 2.25rem;
    object-fit: contain;
  }

  .footer-section__logo-image--dark {
    display: none;
  }

  [data-theme="dark"] .footer-section__logo-image--light {
    display: none;
  }

  [data-theme="dark"] .footer-section__logo-image--dark {
    display: block;
  }

  [data-theme="dark"] .footer-section__logo-link {
    background: color-mix(in srgb, var(--color-white) 8%, transparent);
    border-color: color-mix(in srgb, var(--color-white) 12%, transparent);
  }

  .footer-section__tagline {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: color-mix(in srgb, var(--color-gray-300) 88%, transparent);
  }

  /* ── Columns ───────────────────────────────────────────────── */
  .footer-section__column {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }

  .footer-section__column-title {
    margin: 0 0 var(--space-1);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    letter-spacing: var(--tracking-wide);
    color: var(--color-white);
  }

  .footer-section__link-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-section__link {
    display: inline-flex;
    width: fit-content;
    max-width: 100%;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-gray-400);
    border-radius: var(--radius-sm);
    transition:
      color var(--transition-base),
      transform var(--transition-fast);
  }

  .footer-section__link:hover,
  .footer-section__link:focus-visible {
    color: var(--color-white);
  }

  .footer-section__link:focus-visible {
    outline: 2px solid var(--color-primary-light);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .footer-section__link:hover {
      transform: translateY(-1px);
    }
  }

  /* ── Contact ───────────────────────────────────────────────── */
  .footer-section__contact-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-section__contact-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    min-width: 0;
  }

  .footer-section__contact-icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin-top: 0.125rem;
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-white) 6%, transparent);
    color: var(--color-primary-light);
  }

  .footer-section__contact-icon svg {
    width: 1rem;
    height: 1rem;
  }

  .footer-section__contact-body {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }

  .footer-section__contact-label {
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-gray-500);
  }

  .footer-section__contact-value {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-gray-400);
  }

