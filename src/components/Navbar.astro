---
import logo from "../assets/main-logo.webp";
import ThemeToggle from "./ThemeToggle.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { getTranslations, getLocalePath, type Locale } from "../i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "ar";
const t = getTranslations(locale);

const navLinks = [
  { href: "#features", label: t.nav.links.features },
  { href: "#integrations", label: t.nav.links.integrations },
  { href: "#pricing", label: t.nav.links.pricing },
  { href: "#faq", label: t.nav.links.faq },
  { href: "#contact", label: t.nav.links.contact },
];

const ctaHref = "#cta";
const ctaLabel = t.nav.cta;
const homeHref = getLocalePath(locale);
---

<header
  id="site-header"
  class="navbar"
  data-navbar
  role="banner"
>
  <a href="#main-content" class="navbar__skip-link">
    {t.nav.skipLink}
  </a>

  <div class="navbar__shell">
    <nav
      class="navbar__inner container"
      aria-label={t.nav.ariaLabel}
    >
      <a
        href={homeHref}
        class="navbar__logo"
        aria-label={t.nav.logoAriaLabel}
      >
        <img
          src={logo.src}
          alt={t.nav.logoAlt}
          width={148}
          height={44}
          loading="eager"
          decoding="async"
          class="navbar__logo-image"
        />
      </a>

      <ul class="navbar__links" role="list">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="navbar__link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="navbar__actions">
        <div class="navbar__controls">
          <LanguageSwitcher locale={locale} />
          <ThemeToggle labels={t.theme} />
        </div>

        <a
          href={ctaHref}
          class="btn btn-primary btn-small navbar__cta navbar__cta--desktop"
        >
          {ctaLabel}
        </a>

        <button
          type="button"
          class="navbar__menu-toggle"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="navbar-mobile-menu"
          aria-label={t.nav.openMenu}
          data-menu-open-label={t.nav.openMenu}
          data-menu-close-label={t.nav.closeMenu}
        >
          <span class="navbar__menu-icon" aria-hidden="true">
            <span class="navbar__menu-bar"></span>
            <span class="navbar__menu-bar"></span>
            <span class="navbar__menu-bar"></span>
          </span>
        </button>
      </div>
    </nav>
  </div>

  <div
    id="navbar-mobile-menu"
    class="navbar__mobile-panel"
    data-mobile-menu
    hidden
  >
    <div class="navbar__mobile-backdrop" data-menu-backdrop aria-hidden="true"></div>

    <div class="navbar__mobile-drawer" role="dialog" aria-modal="true" aria-label={t.nav.mobileMenuLabel}>
      <div class="navbar__mobile-toolbar">
        <LanguageSwitcher locale={locale} variant="full" />
        <ThemeToggle labels={t.theme} />
      </div>

      <ul class="navbar__mobile-links" role="list">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="navbar__mobile-link" data-mobile-link>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a
        href={ctaHref}
        class="btn btn-primary navbar__mobile-cta"
        data-mobile-link
      >
        {ctaLabel}
      </a>
    </div>
  </div>
</header>

<script>
  const SCROLL_THRESHOLD = 12;
  const HIDE_OFFSET = 96;

  function initNavbar(header: HTMLElement) {
    const abortController = new AbortController();
    const { signal } = abortController;

    let lastScrollY = window.scrollY;
    let ticking = false;

    const menuToggle = header.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const mobileMenu = header.querySelector<HTMLElement>("[data-mobile-menu]");
    const mobileBackdrop = header.querySelector<HTMLElement>("[data-menu-backdrop]");
    const mobileLinks = header.querySelectorAll<HTMLAnchorElement>("[data-mobile-link]");
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const updateScrollState = () => {
      const currentScrollY = window.scrollY;
      const isScrolled = currentScrollY > SCROLL_THRESHOLD;

      header.classList.toggle("navbar--scrolled", isScrolled);

      if (!prefersReducedMotion.matches && currentScrollY > HIDE_OFFSET) {
        const isScrollingDown = currentScrollY > lastScrollY;
        header.classList.toggle("navbar--hidden", isScrollingDown);
      } else {
        header.classList.remove("navbar--hidden");
      }

      lastScrollY = currentScrollY;
      ticking = false;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(updateScrollState);
    };

    const setMenuOpen = (isOpen: boolean) => {
      if (!menuToggle || !mobileMenu) return;

      const openLabel = menuToggle.dataset.menuOpenLabel ?? "Open navigation menu";
      const closeLabel = menuToggle.dataset.menuCloseLabel ?? "Close navigation menu";

      menuToggle.setAttribute("aria-expanded", String(isOpen));
      menuToggle.setAttribute("aria-label", isOpen ? closeLabel : openLabel);
      mobileMenu.hidden = !isOpen;
      header.classList.toggle("navbar--menu-open", isOpen);
      document.body.classList.toggle("navbar-menu-open", isOpen);

      if (isOpen) {
        mobileMenu.querySelector<HTMLElement>("[data-mobile-link]")?.focus();
      }
    };

    const closeMenu = () => setMenuOpen(false);

    const onMenuToggle = () => {
      const isOpen = menuToggle?.getAttribute("aria-expanded") === "true";
      setMenuOpen(!isOpen);
    };

    const onKeyDown = (event: KeyboardEvent) => {
      if (event.key === "Escape" && menuToggle?.getAttribute("aria-expanded") === "true") {
        closeMenu();
        menuToggle?.focus();
      }
    };

    updateScrollState();
    window.addEventListener("scroll", onScroll, { passive: true, signal });
    menuToggle?.addEventListener("click", onMenuToggle, { signal });
    mobileBackdrop?.addEventListener("click", closeMenu, { signal });
    document.addEventListener("keydown", onKeyDown, { signal });

    mobileLinks.forEach((link) => {
      link.addEventListener("click", closeMenu, { signal });
    });

    prefersReducedMotion.addEventListener(
      "change",
      () => {
        if (prefersReducedMotion.matches) {
          header.classList.remove("navbar--hidden");
        }
      },
      { signal },
    );

    return () => {
      abortController.abort();
      document.body.classList.remove("navbar-menu-open");
    };
  }

  let cleanupNavbar: (() => void) | null = null;

  function mountNavbar() {
    cleanupNavbar?.();
    cleanupNavbar = null;

    const header = document.querySelector<HTMLElement>("[data-navbar]");
    if (!header) return;

    cleanupNavbar = initNavbar(header);
  }

  document.addEventListener("astro:before-swap", () => {
    cleanupNavbar?.();
    cleanupNavbar = null;
  });

  mountNavbar();
  document.addEventListener("astro:page-load", mountNavbar);
</script>

<style is:global>
  .navbar {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: var(--z-fixed);
    pointer-events: none;
    transform: translateY(0);
    transition:
      transform var(--transition-base),
      background-color var(--transition-base),
      border-color var(--transition-base),
      box-shadow var(--transition-base);
  }

  .navbar--hidden {
    transform: translateY(calc(-100% - var(--space-2)));
  }

  .navbar__shell {
    pointer-events: auto;
    border-block-end: 1px solid transparent;
    transition:
      background-color var(--transition-base),
      border-color var(--transition-base),
      backdrop-filter var(--transition-base),
      box-shadow var(--transition-base);
  }

  .navbar--scrolled .navbar__shell {
    background: color-mix(in srgb, var(--bg-primary) 82%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-block-end-color: var(--border-primary);
    box-shadow: var(--shadow-sm);
  }

  [data-theme="dark"] .navbar--scrolled .navbar__shell {
    background: color-mix(in srgb, var(--bg-primary) 78%, transparent);
  }

  .navbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 4.5rem;
  }

  .navbar__skip-link {
    position: absolute;
    inset-block-start: var(--space-2);
    inset-inline-start: var(--space-2);
    z-index: calc(var(--z-fixed) + 2);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-base);
    background: var(--color-primary);
    color: var(--color-white);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    transform: translateY(-200%);
    transition: transform var(--transition-fast);
    pointer-events: auto;
  }

  .navbar__skip-link:focus-visible {
    transform: translateY(0);
    outline: 2px solid var(--color-white);
    outline-offset: 2px;
  }

  .navbar__logo {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .navbar__logo:hover {
    color: inherit;
  }

  .navbar__logo:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .navbar__logo-image {
    width: auto;
    height: 2.25rem;
    object-fit: contain;
  }

  .navbar__links {
    display: none;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .navbar__link {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-base);
    color: var(--color-gray-600);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .navbar__link:hover {
    color: var(--color-primary);
    background: var(--color-primary-alpha-10);
  }

  .navbar__link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  [data-theme="dark"] .navbar__link {
    color: var(--color-gray-200);
  }

  [data-theme="dark"] .navbar__mobile-link {
    color: var(--color-gray-100);
  }

  .navbar__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .navbar__controls {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .navbar__mobile-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-primary);
  }

  .navbar__cta {
    white-space: nowrap;
  }

  .navbar__menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-full);
    background: var(--bg-secondary);
    color: var(--color-gray-700);
    cursor: pointer;
    transition:
      background-color var(--transition-base),
      border-color var(--transition-base);
  }

  .navbar__menu-toggle:hover {
    background: var(--color-primary-alpha-10);
    border-color: var(--color-primary-alpha-20);
    color: var(--color-primary);
  }

  .navbar__menu-toggle:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  [data-theme="dark"] .navbar__menu-toggle {
    background: var(--bg-secondary);
    color: var(--color-gray-100);
    border-color: var(--border-secondary);
  }

  [data-theme="dark"] .navbar__menu-toggle:hover {
    background: var(--color-primary-alpha-20);
    color: var(--color-primary-light);
  }

  .navbar__menu-icon {
    display: grid;
    gap: 0.3125rem;
  }

  .navbar__menu-bar {
    display: block;
    width: 1.125rem;
    height: 2px;
    border-radius: var(--radius-full);
    background: currentColor;
    transition:
      transform var(--transition-base),
      opacity var(--transition-base);
  }

  .navbar--menu-open .navbar__menu-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .navbar--menu-open .navbar__menu-bar:nth-child(2) {
    opacity: 0;
  }

  .navbar--menu-open .navbar__menu-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .navbar__mobile-panel {
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-fixed) + 1);
    pointer-events: none;
  }

  .navbar__mobile-panel:not([hidden]) {
    pointer-events: auto;
  }

  .navbar__mobile-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.45);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .navbar--menu-open .navbar__mobile-backdrop {
    opacity: 1;
  }

  .navbar__mobile-drawer {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: min(100%, 20rem);
    padding: calc(4.5rem + var(--space-4)) var(--space-6) var(--space-6);
    background: var(--bg-primary);
    border-inline-end: 1px solid var(--border-primary);
    box-shadow: var(--shadow-xl);
    transform: translateX(100%);
    transition: transform var(--transition-base);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .navbar--menu-open .navbar__mobile-drawer {
    transform: translateX(0);
  }

  .navbar__mobile-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .navbar__mobile-link {
    display: block;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    color: var(--color-gray-800);
    font-size: var(--text-base);
    font-weight: var(--font-medium);
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .navbar__mobile-link:hover {
    color: var(--color-white);
    background: var(--color-primary);
  }

  .navbar__mobile-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .navbar__mobile-cta {
    width: 100%;
    margin-top: auto;
  }

  @media (min-width: 1024px) {
    .navbar__links {
      display: flex;
    }

    .navbar__menu-toggle {
      display: none;
    }

    .navbar__mobile-panel {
      display: none;
    }
  }

  @media (max-width: 1023px) {
    .navbar__controls {
      display: none;
    }

    .navbar__cta--desktop {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    .navbar__mobile-toolbar {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .navbar,
    .navbar__shell,
    .navbar__link,
    .navbar__mobile-drawer,
    .navbar__mobile-backdrop,
    .navbar__menu-bar {
      transition: none;
    }

    .navbar--hidden {
      transform: none;
    }
  }
</style>
