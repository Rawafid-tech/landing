---
import { getImage } from "astro:assets";
import logoSrc from "../assets/main-logo.webp";
import ThemeToggle from "./ThemeToggle.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { getTranslations, getLocalePath, type Locale } from "../i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "ar";
const t = getTranslations(locale);

const logoAspectRatio = logoSrc.width / logoSrc.height;
const logoWidths = [110, 220] as const;

const logoImages = await Promise.all(
  logoWidths.map((width) =>
    getImage({
      src: logoSrc,
      width,
      height: Math.round(width / logoAspectRatio),
      format: "webp",
      quality: 82,
    }),
  ),
);

const logoSrcSet = logoImages
  .map((image, index) => `${image.src} ${logoWidths[index]}w`)
  .join(", ");
const logoFallback = logoImages[0];
const logoSizes = `${logoWidths[0]}px`;

const navLinks = [
  { href: "#features", label: t.nav.links.features },
  { href: "#integrations", label: t.nav.links.integrations },
  { href: "#pricing", label: t.nav.links.pricing },
  { href: "#faq", label: t.nav.links.faq },
  { href: "#contact", label: t.nav.links.contact },
];

const ctaHref = "#cta";
const ctaLabel = t.nav.cta;
const homeHref = getLocalePath(locale);
---

<div class="navbar-system" data-navbar>
  <header
    id="site-header"
    class="navbar"
    role="banner"
  >
    <a href="#main-content" class="navbar__skip-link">
      {t.nav.skipLink}
    </a>

    <div class="navbar__shell">
      <nav
        class="navbar__inner container"
        aria-label={t.nav.ariaLabel}
      >
      <a
        href={homeHref}
        class="navbar__logo"
        aria-label={t.nav.logoAriaLabel}
      >
        <img
          src={logoFallback.src}
          srcset={logoSrcSet}
          sizes={logoSizes}
          alt={t.nav.logoAlt}
          width={logoFallback.attributes.width}
          height={logoFallback.attributes.height}
          loading="eager"
          decoding="async"
          class="navbar__logo-image"
        />
      </a>

      <ul class="navbar__links" role="list">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="navbar__link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="navbar__actions">
        <div class="navbar__controls">
          <LanguageSwitcher locale={locale} />
          <ThemeToggle labels={t.theme} />
        </div>

        <a
          href={ctaHref}
          class="btn btn-primary btn-small navbar__cta navbar__cta--desktop"
        >
          {ctaLabel}
        </a>

        <button
          type="button"
          class="navbar__menu-toggle"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="navbar-mobile-menu"
          aria-label={t.nav.openMenu}
          data-menu-open-label={t.nav.openMenu}
          data-menu-close-label={t.nav.closeMenu}
        >
          <span class="navbar__menu-icon" aria-hidden="true">
            <span class="navbar__menu-bar"></span>
            <span class="navbar__menu-bar"></span>
            <span class="navbar__menu-bar"></span>
          </span>
        </button>
      </div>
    </nav>
  </div>
  </header>

  <div
    id="navbar-mobile-menu"
    class="navbar__mobile-panel"
    data-mobile-menu
    hidden
  >
    <div class="navbar__mobile-backdrop" data-menu-backdrop aria-hidden="true"></div>

    <div class="navbar__mobile-drawer" role="dialog" aria-modal="true" aria-label={t.nav.mobileMenuLabel}>
      <div class="navbar__mobile-header">
        <a href={homeHref} class="navbar__mobile-logo" data-mobile-link aria-label={t.nav.logoAriaLabel}>
          <img
            src={logoFallback.src}
            srcset={logoSrcSet}
            sizes={logoSizes}
            alt=""
            width={logoFallback.attributes.width}
            height={logoFallback.attributes.height}
            loading="eager"
            decoding="async"
            class="navbar__logo-image"
          />
        </a>
        <button
          type="button"
          class="navbar__mobile-close"
          data-menu-close
          aria-label={t.nav.closeMenu}
        >
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <div class="navbar__mobile-toolbar">
        <LanguageSwitcher locale={locale} variant="full" />
        <ThemeToggle labels={t.theme} />
      </div>

      <nav class="navbar__mobile-nav" aria-label={t.nav.ariaLabel}>
        <ul class="navbar__mobile-links" role="list">
          {
            navLinks.map((link, index) => (
              <li style={`--link-index: ${index}`}>
                <a href={link.href} class="navbar__mobile-link" data-mobile-link>
                  <span class="navbar__mobile-link-text">{link.label}</span>
                  <span class="navbar__mobile-link-arrow" aria-hidden="true">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="navbar__mobile-footer">
        <a
          href={ctaHref}
          class="btn btn-primary navbar__mobile-cta"
          data-mobile-link
        >
          {ctaLabel}
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  const SCROLL_THRESHOLD = 12;

  function initNavbar(root: HTMLElement) {
    const abortController = new AbortController();
    const { signal } = abortController;

    let ticking = false;

    const mobileMenu = root.querySelector<HTMLElement>("[data-mobile-menu]");
    if (mobileMenu && mobileMenu.parentElement !== document.body) {
      document.body.appendChild(mobileMenu);
    }

    const menuToggle = root.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const menuClose = mobileMenu?.querySelector<HTMLButtonElement>("[data-menu-close]");
    const mobileDrawer = mobileMenu?.querySelector<HTMLElement>(".navbar__mobile-drawer");
    const mobileBackdrop = mobileMenu?.querySelector<HTMLElement>("[data-menu-backdrop]");
    const mobileLinks = mobileMenu?.querySelectorAll<HTMLAnchorElement>("[data-mobile-link]") ?? [];
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const updateScrollState = () => {
      root.classList.toggle("navbar--scrolled", window.scrollY > SCROLL_THRESHOLD);
      ticking = false;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(updateScrollState);
    };

    const setMenuOpen = (isOpen: boolean) => {
      if (!menuToggle || !mobileMenu) return;

      const openLabel = menuToggle.dataset.menuOpenLabel ?? "Open navigation menu";
      const closeLabel = menuToggle.dataset.menuCloseLabel ?? "Close navigation menu";

      menuToggle.setAttribute("aria-expanded", String(isOpen));
      menuToggle.setAttribute("aria-label", isOpen ? closeLabel : openLabel);

      if (isOpen) {
        mobileMenu.hidden = false;
        requestAnimationFrame(() => {
          root.classList.add("navbar--menu-open");
        });
        document.body.classList.add("navbar-menu-open");
        mobileMenu.querySelector<HTMLElement>("[data-mobile-link]")?.focus();
        return;
      }

      root.classList.remove("navbar--menu-open");
      document.body.classList.remove("navbar-menu-open");

      if (prefersReducedMotion.matches) {
        mobileMenu.hidden = true;
        return;
      }

      const finishClose = (event: TransitionEvent) => {
        if (event.target !== mobileDrawer || event.propertyName !== "transform") return;
        mobileDrawer.removeEventListener("transitionend", finishClose);
        if (menuToggle.getAttribute("aria-expanded") !== "true") {
          mobileMenu.hidden = true;
        }
      };

      mobileDrawer?.addEventListener("transitionend", finishClose);
    };

    const closeMenu = () => setMenuOpen(false);

    const onMenuToggle = () => {
      const isOpen = menuToggle?.getAttribute("aria-expanded") === "true";
      setMenuOpen(!isOpen);
    };

    const onKeyDown = (event: KeyboardEvent) => {
      if (event.key === "Escape" && menuToggle?.getAttribute("aria-expanded") === "true") {
        closeMenu();
        menuToggle?.focus();
      }
    };

    updateScrollState();
    window.addEventListener("scroll", onScroll, { passive: true, signal });
    menuToggle?.addEventListener("click", onMenuToggle, { signal });
    menuClose?.addEventListener("click", closeMenu, { signal });
    mobileBackdrop?.addEventListener("click", closeMenu, { signal });
    document.addEventListener("keydown", onKeyDown, { signal });

    mobileLinks.forEach((link) => {
      link.addEventListener("click", closeMenu, { signal });
    });

    return () => {
      abortController.abort();
      document.body.classList.remove("navbar-menu-open");
    };
  }

  let cleanupNavbar: (() => void) | null = null;

  function mountNavbar() {
    cleanupNavbar?.();
    cleanupNavbar = null;

    const header = document.querySelector<HTMLElement>("[data-navbar]");
    if (!header) return;

    cleanupNavbar = initNavbar(header);
  }

  document.addEventListener("astro:before-swap", () => {
    cleanupNavbar?.();
    cleanupNavbar = null;
  });

  mountNavbar();
  document.addEventListener("astro:page-load", mountNavbar);
</script>

<style is:global>
  .navbar-system {
    position: relative;
  }

  .navbar {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: var(--z-fixed);
    pointer-events: none;
  }

  .navbar__shell {
    pointer-events: auto;
    border-block-end: 1px solid transparent;
    transition:
      background-color var(--transition-base),
      border-color var(--transition-base),
      backdrop-filter var(--transition-base),
      box-shadow var(--transition-base);
  }

  .navbar-system.navbar--scrolled .navbar__shell {
    background: color-mix(in srgb, var(--bg-primary) 82%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-block-end-color: var(--border-primary);
    box-shadow: var(--shadow-sm);
  }

  [data-theme="dark"] .navbar-system.navbar--scrolled .navbar__shell {
    background: color-mix(in srgb, var(--bg-primary) 78%, transparent);
  }

  .navbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 4.5rem;
  }

  .navbar__skip-link {
    position: absolute;
    inset-block-start: var(--space-2);
    inset-inline-start: var(--space-2);
    z-index: calc(var(--z-fixed) + 2);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-base);
    background: var(--color-primary);
    color: var(--color-white);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    transform: translateY(-200%);
    transition: transform var(--transition-fast);
    pointer-events: auto;
  }

  .navbar__skip-link:focus-visible {
    transform: translateY(0);
    outline: 2px solid var(--color-white);
    outline-offset: 2px;
  }

  .navbar__logo {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .navbar__logo:hover {
    color: inherit;
  }

  .navbar__logo:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .navbar__logo-image {
    width: auto;
    height: 2.25rem;
    object-fit: contain;
  }

  .navbar__links {
    display: none;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .navbar__link {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-base);
    color: var(--color-gray-600);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .navbar__link:hover {
    color: var(--color-primary);
    background: var(--color-primary-alpha-10);
  }

  .navbar__link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  [data-theme="dark"] .navbar__link {
    color: var(--color-gray-200);
  }

  .navbar__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .navbar__controls {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .navbar__mobile-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3);
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
    border: 1px solid var(--border-primary);
  }

  [data-theme="dark"] .navbar__mobile-toolbar {
    background: color-mix(in srgb, var(--bg-secondary) 80%, transparent);
    border-color: var(--border-secondary);
  }

  .navbar__cta {
    white-space: nowrap;
  }

  .navbar__menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-full);
    background: var(--bg-secondary);
    color: var(--color-gray-700);
    cursor: pointer;
    transition:
      background-color var(--transition-base),
      border-color var(--transition-base);
  }

  .navbar__menu-toggle:hover {
    background: var(--color-primary-alpha-10);
    border-color: var(--color-primary-alpha-20);
    color: var(--color-primary);
  }

  .navbar__menu-toggle:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  [data-theme="dark"] .navbar__menu-toggle {
    background: var(--bg-secondary);
    color: var(--color-gray-100);
    border-color: var(--border-secondary);
  }

  [data-theme="dark"] .navbar__menu-toggle:hover {
    background: var(--color-primary-alpha-20);
    color: var(--color-primary-light);
  }

  .navbar__menu-icon {
    display: grid;
    gap: 0.3125rem;
  }

  .navbar__menu-bar {
    display: block;
    width: 1.125rem;
    height: 2px;
    border-radius: var(--radius-full);
    background: currentColor;
    transition:
      transform var(--transition-base),
      opacity var(--transition-base);
  }

  .navbar-system.navbar--menu-open .navbar__menu-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .navbar-system.navbar--menu-open .navbar__menu-bar:nth-child(2) {
    opacity: 0;
  }

  .navbar-system.navbar--menu-open .navbar__menu-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .navbar__mobile-panel {
    position: fixed;
    inset: 0;
    width: auto;
    max-width: none;
    height: auto;
    min-height: 100dvh;
    margin: 0;
    padding: 0;
    border: none;
    z-index: calc(var(--z-fixed) + 10);
    pointer-events: none;
    overflow: hidden;
  }

  .navbar__mobile-panel:not([hidden]) {
    pointer-events: auto;
  }

  .navbar__mobile-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.35s var(--ease-out);
    z-index: 1;
    pointer-events: none;
  }

  body.navbar-menu-open .navbar__mobile-backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  .navbar__mobile-drawer {
    position: fixed;
    inset: 0;
    width: auto;
    max-width: none;
    height: auto;
    min-height: 100dvh;
    margin: 0;
    padding:
      calc(env(safe-area-inset-top, 0px) + var(--space-5))
      var(--space-5)
      calc(env(safe-area-inset-bottom, 0px) + var(--space-5));
    background: var(--bg-primary);
    border: none;
    border-radius: 0;
    box-shadow: none;
    transform: translate3d(-100%, 0, 0);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    overflow-y: auto;
    overscroll-behavior: contain;
    z-index: 2;
  }

  [dir="rtl"] .navbar__mobile-drawer {
    transform: translate3d(100%, 0, 0);
  }

  body.navbar-menu-open .navbar__mobile-drawer {
    transform: translate3d(0, 0, 0);
  }

  .navbar__mobile-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-primary);
  }

  .navbar__mobile-logo {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .navbar__mobile-logo .navbar__logo-image {
    height: 2rem;
  }

  .navbar__mobile-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-full);
    background: var(--bg-secondary);
    color: var(--color-gray-600);
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .navbar__mobile-close svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .navbar__mobile-close:hover {
    background: var(--color-primary-alpha-10);
    border-color: var(--color-primary-alpha-20);
    color: var(--color-primary);
    transform: rotate(90deg);
  }

  .navbar__mobile-close:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  [data-theme="dark"] .navbar__mobile-close {
    color: var(--color-gray-200);
    border-color: var(--border-secondary);
  }

  .navbar__mobile-nav {
    flex: 1;
  }

  .navbar__mobile-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-1);
  }

  .navbar__mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    color: var(--color-gray-800);
    font-size: var(--text-base);
    font-weight: var(--font-medium);
    background: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    opacity: 0;
    transform: translateX(-1rem);
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast);
    transition-delay: calc(var(--link-index, 0) * 40ms + 60ms);
  }

  [data-theme="dark"] .navbar__mobile-link {
    color: var(--color-gray-100);
    background: color-mix(in srgb, var(--bg-secondary) 70%, transparent);
    border-color: var(--border-secondary);
  }

  [dir="rtl"] .navbar__mobile-link {
    transform: translateX(1rem);
  }

  body.navbar-menu-open .navbar__mobile-link {
    opacity: 1;
    transform: translateX(0);
  }

  .navbar__mobile-link-text {
    flex: 1;
  }

  .navbar__mobile-link-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--radius-full);
    background: var(--bg-secondary);
    color: var(--color-gray-500);
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .navbar__mobile-link-arrow svg {
    width: 0.875rem;
    height: 0.875rem;
  }

  [dir="rtl"] .navbar__mobile-link-arrow svg {
    transform: scaleX(-1);
  }

  .navbar__mobile-link:hover,
  .navbar__mobile-link:focus-visible {
    color: var(--color-primary);
    background: var(--color-primary-alpha-10);
    border-color: var(--color-primary-alpha-20);
  }

  .navbar__mobile-link:hover .navbar__mobile-link-arrow,
  .navbar__mobile-link:focus-visible .navbar__mobile-link-arrow {
    background: var(--color-primary);
    color: var(--color-white);
    transform: translateX(2px);
  }

  [dir="rtl"] .navbar__mobile-link:hover .navbar__mobile-link-arrow,
  [dir="rtl"] .navbar__mobile-link:focus-visible .navbar__mobile-link-arrow {
    transform: translateX(-2px);
  }

  .navbar__mobile-link:focus-visible {
    outline: none;
  }

  .navbar__mobile-footer {
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-primary);
    opacity: 0;
    transform: translateY(0.75rem);
    transition:
      opacity 0.35s var(--ease-out) 0.28s,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1) 0.28s;
  }

  body.navbar-menu-open .navbar__mobile-footer {
    opacity: 1;
    transform: translateY(0);
  }

  .navbar__mobile-cta {
    width: 100%;
  }

  @media (min-width: 1024px) {
    .navbar__links {
      display: flex;
    }

    .navbar__menu-toggle {
      display: none;
    }

    .navbar__mobile-panel {
      display: none;
    }
  }

  @media (max-width: 1023px) {
    .navbar__controls {
      display: none;
    }

    .navbar__cta--desktop {
      display: none;
    }

    .navbar__shell {
      background: color-mix(in srgb, var(--bg-primary) 88%, transparent);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-block-end-color: var(--border-primary);
    }

    .navbar-system.navbar--menu-open .navbar__shell {
      border-block-end-color: transparent;
    }

    .navbar__inner {
      min-height: 4rem;
    }

    .navbar__actions {
      gap: var(--space-3);
    }
  }

  @media (min-width: 1024px) {
    .navbar__mobile-toolbar {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .navbar__shell,
    .navbar__link,
    .navbar__mobile-drawer,
    .navbar__mobile-backdrop,
    .navbar__mobile-link,
    .navbar__mobile-footer,
    .navbar__menu-bar,
    .navbar__mobile-close {
      transition: none;
    }

    .navbar__mobile-link,
    .navbar__mobile-footer {
      opacity: 1;
      transform: none;
    }
  }
</style>
