---
import { getImage } from "astro:assets";
import SectionHeader from "./SectionHeader.astro";
import { getTranslations, type Locale } from "../i18n";

import dashboardsImg from "../assets/problems/dashboards.png";
import trackingImg from "../assets/problems/tracking.png";
import returnsImg from "../assets/problems/returns.png";
import manualImg from "../assets/problems/manual.png";
import pricingImg from "../assets/problems/pricing.png";
import hiddenCostsImg from "../assets/problems/hidden-costs.png";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "ar";
const t = getTranslations(locale);
const s = t.problemSection;

// Cards render at ~400px in the 3-column grid and full width on phones.
const ASPECT = 10 / 16;
const WIDTHS = [450, 640, 900] as const;
const SIZES = "(min-width: 1024px) 400px, (min-width: 640px) calc(50vw - 3rem), calc(100vw - 2rem)";

const rawImages = {
  dashboards: dashboardsImg,
  tracking: trackingImg,
  returns: returnsImg,
  manual: manualImg,
  pricing: pricingImg,
  "hidden-costs": hiddenCostsImg,
} as const;

type ProblemImageKey = keyof typeof rawImages;

async function buildSrcSet(src: ImageMetadata, format: "avif" | "webp") {
  const images = await Promise.all(
    WIDTHS.map((width) =>
      getImage({ src, width, height: Math.round(width * ASPECT), format, quality: format === "avif" ? 60 : 75 }),
    ),
  );
  return {
    srcSet: images.map((image, index) => `${image.src} ${WIDTHS[index]}w`).join(", "),
    fallback: images[0].src,
  };
}

const images = Object.fromEntries(
  await Promise.all(
    (Object.entries(rawImages) as [ProblemImageKey, ImageMetadata][]).map(async ([key, src]) => {
      const [avif, webp] = await Promise.all([buildSrcSet(src, "avif"), buildSrcSet(src, "webp")]);
      return [key, { avifSrcSet: avif.srcSet, webpSrcSet: webp.srcSet, src: webp.fallback }];
    }),
  ),
) as Record<ProblemImageKey, { avifSrcSet: string; webpSrcSet: string; src: string }>;
---

<section id="problems" class="problem-section" aria-labelledby="problems-heading">
  <div class="container flex flex-col gap-12 lg:gap-16">
    <SectionHeader
      id="problems-heading"
      eyebrow={s.eyebrow}
      headline={s.headline}
      subheadline={s.subheadline}
    />

    <ul class="m-0 grid list-none grid-cols-1 gap-6 p-0 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8" role="list">
      {
        s.problems.map((problem, index) => {
          const image = images[problem.image];
          return (
            <li class="problem-card" data-reveal style={`--reveal-delay: ${(index % 3) * 80}ms`}>
              <div class="problem-card__image-wrapper">
                <picture>
                  <source type="image/avif" srcset={image.avifSrcSet} sizes={SIZES} />
                  <source type="image/webp" srcset={image.webpSrcSet} sizes={SIZES} />
                  <img
                    src={image.src}
                    alt=""
                    width={WIDTHS[0]}
                    height={Math.round(WIDTHS[0] * ASPECT)}
                    loading="lazy"
                    decoding="async"
                    class="problem-card__image"
                  />
                </picture>
                <div class="problem-card__image-overlay" aria-hidden="true"></div>
              </div>

              <div class="problem-card__content">
                <h3 class="problem-card__title">{problem.title}</h3>
                <p class="problem-card__description">{problem.description}</p>
                <p class="problem-card__solution">
                  <svg class="problem-card__solution-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="8" cy="8" r="6.5" />
                    <path d="M5 8.5l2 2 4-4.5" />
                  </svg>
                  <span>
                    <strong class="problem-card__solution-label">{s.solutionLabel}:</strong>
                    {problem.solution}
                  </span>
                </p>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style is:global>
  .problem-section {
    position: relative;
    padding-block: var(--space-6) var(--space-8);
    background: var(--bg-secondary);
  }

  [data-theme="dark"] .problem-section {
    background: var(--bg-primary);
  }

  @media (min-width: 1024px) {
    .problem-section {
      padding-block: var(--space-8) var(--space-10);
    }
  }

  .problem-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-xl);
    background: var(--bg-primary);
    border: 1px solid var(--border-primary);
    overflow: hidden;
    transition:
      border-color var(--transition-base),
      box-shadow var(--transition-base),
      transform var(--transition-base);
  }

  .problem-card:hover {
    border-color: var(--color-primary-alpha-20);
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  [data-theme="dark"] .problem-card {
    background: var(--bg-secondary);
    border-color: var(--border-primary);
  }

  [data-theme="dark"] .problem-card:hover {
    border-color: color-mix(in srgb, var(--color-primary) 30%, var(--border-secondary));
    box-shadow: var(--shadow-lg);
  }

  .problem-card__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-gray-100);
  }

  [data-theme="dark"] .problem-card__image-wrapper {
    background: var(--color-gray-800);
  }

  .problem-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .problem-card:hover .problem-card__image {
    transform: scale(1.05);
  }

  .problem-card__image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 60%,
      color-mix(in srgb, var(--color-gray-900) 10%, transparent) 100%
    );
    pointer-events: none;
  }

  [data-theme="dark"] .problem-card__image-overlay {
    background: linear-gradient(
      to bottom,
      transparent 60%,
      color-mix(in srgb, var(--color-gray-900) 30%, transparent) 100%
    );
  }

  .problem-card__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-6);
  }

  .problem-card__solution {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin: auto 0 0;
    padding-block-start: var(--space-4);
    border-block-start: 1px dashed var(--border-primary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-gray-700);
  }

  .problem-card__solution-icon {
    flex-shrink: 0;
    width: 1.125rem;
    height: 1.125rem;
    margin-block-start: 0.15em;
    color: #15803d;
  }

  [data-theme="dark"] .problem-card__solution-icon {
    color: var(--color-accent);
  }

  .problem-card__solution-label {
    font-weight: var(--font-semibold);
    color: #15803d; /* green-700: 5:1 on white; accent-dark is only 3.3:1 */
  }

  [data-theme="dark"] .problem-card__solution-label {
    color: var(--color-accent-light);
  }

  @media (min-width: 1024px) {
    .problem-card__content {
      padding: var(--space-6);
    }
  }

  .problem-card__title {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    line-height: var(--leading-snug);
    color: var(--color-gray-900);
  }

  [data-theme="dark"] .problem-card__title {
    color: var(--color-gray-50);
  }

  .problem-card__description {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-gray-600);
  }

  [data-theme="dark"] .problem-card__description {
    color: var(--color-gray-400);
  }

  @media (prefers-reduced-motion: reduce) {
    .problem-card,
    .problem-card__image {
      transition: none;
    }

    .problem-card:hover {
      transform: none;
    }

    .problem-card:hover .problem-card__image {
      transform: none;
    }
  }
</style>
