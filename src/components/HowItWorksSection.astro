---
import SectionHeader from "./SectionHeader.astro";
import { getTranslations, localeConfig, type Locale } from "../i18n";
import { SIGNUP_URL } from "../config/site";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "ar";
const t = getTranslations(locale);
const { howItWorksSection: s } = t;
const isRtl = localeConfig[locale].dir === "rtl";

type StepIcon = (typeof s.steps)[number]["icon"];

const ICONS: Record<StepIcon, string> = {
  connect:
    '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
  create:
    '<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>',
  track: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
};

const ARROW = '<path d="M5 12h14M13 6l6 6-6 6"/>';
// Always Western numerals regardless of page locale.
const stepNumber = (index: number) => String(index + 1).padStart(2, "0");
const railColumns = s.steps.flatMap((_, i) => (i < s.steps.length - 1 ? ["auto", "1fr"] : ["auto"])).join(" ");
---

<section id="how-it-works" class="hiw-section" aria-labelledby="how-it-works-heading">
  <div class="hiw-section__glow hiw-section__glow--start" aria-hidden="true"></div>
  <div class="hiw-section__glow hiw-section__glow--end" aria-hidden="true"></div>

  <div class="container hiw-section__container">
    <div class="flex w-full flex-col gap-12 lg:gap-16">
      <SectionHeader
        id="how-it-works-heading"
        eyebrow={s.eyebrow}
        headline={s.headline}
        subheadline={s.subheadline}
      />

      <!-- Desktop stepper rail (decorative) -->
      <div
        class="hiw-flow-rail hidden w-full md:grid"
        aria-hidden="true"
        data-reveal
        style={`grid-template-columns: ${railColumns}; column-gap: 0.5rem;`}
      >
        {
          s.steps.map((step, i) => (
            <Fragment>
              <div class="flex h-14 items-center justify-center" style={`grid-column: ${i * 2 + 1}`}>
                <div class="hiw-flow-node flex shrink-0 flex-col items-center justify-center">
                  <div class={`hiw-flow-node__ring hiw-flow-node__ring--${step.icon}`}>
                    <div class={`hiw-node hiw-node--${step.icon} flex h-14 w-14 items-center justify-center rounded-full border-2`}>
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="block shrink-0" set:html={ICONS[step.icon]} />
                    </div>
                  </div>
                </div>
              </div>
              {i < s.steps.length - 1 && (
                <div class="flex h-14 w-full min-w-0 items-center px-1" style={`grid-column: ${i * 2 + 2}`}>
                  <div class="hiw-flow-bridge flex w-full min-w-0 flex-1 items-center">
                    <div class="hiw-flow-bridge__track relative h-[3px] min-w-0 flex-1 overflow-hidden rounded-full">
                      <div class="hiw-flow-bridge__bg absolute inset-0 rounded-full" />
                      <div
                        class:list={["hiw-flow-bridge__shimmer absolute inset-0 rounded-full", isRtl && "hiw-flow-bridge__shimmer--rtl"]}
                        style={`animation-delay: ${i * 0.5}s`}
                      />
                    </div>
                    <svg
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class:list={["hiw-flow-arrow block shrink-0", isRtl && "hiw-flow-arrow--rtl"]}
                      style={`animation-delay: ${i * 0.3 + 0.2}s`}
                      set:html={ARROW}
                    />
                  </div>
                </div>
              )}
            </Fragment>
          ))
        }
      </div>

      <ol class="m-0 grid w-full list-none grid-cols-1 gap-6 p-0 md:grid-cols-3 md:gap-6 lg:gap-8" role="list">
        {
          s.steps.map((step, i) => (
            <li
              class={`hiw-step hiw-step--${step.icon} flex min-w-0 flex-row items-stretch gap-5 md:flex-col`}
              data-reveal
              style={`--reveal-delay: ${i * 150}ms`}
            >
              <!-- Mobile vertical timeline (decorative) -->
              <div class="flex w-14 shrink-0 flex-col items-center md:hidden" aria-hidden="true">
                <div class={`hiw-node hiw-node--${step.icon} flex h-14 w-14 items-center justify-center rounded-full border-2`}>
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="block shrink-0" set:html={ICONS[step.icon]} />
                </div>
                {i < s.steps.length - 1 && (
                  <div class="hiw-mobile-bridge relative my-2 flex min-h-8 w-[3px] flex-1 flex-col items-center overflow-hidden rounded-full">
                    <div class="hiw-flow-bridge__bg absolute inset-0 rounded-full" />
                    <div class="hiw-flow-bridge__shimmer-vertical absolute inset-0 rounded-full" />
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hiw-flow-arrow block shrink-0" set:html={ARROW} />
                  </div>
                )}
              </div>

              <article class="hiw-card flex min-h-[11rem] min-w-0 flex-1 flex-col gap-5 lg:gap-6">
                <header class="flex items-start justify-between gap-4">
                  <div class={`hiw-node hiw-node--${step.icon} flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border`} aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="block shrink-0" set:html={ICONS[step.icon]} />
                  </div>
                  <span
                    class={`hiw-badge hiw-badge--${step.icon} inline-flex shrink-0 items-center rounded-full px-3 py-1 text-xs font-bold tabular-nums tracking-widest`}
                    dir="ltr"
                    aria-hidden="true"
                  >
                    {stepNumber(i)}
                  </span>
                </header>

                <div class="flex flex-col gap-3">
                  <h3 class="hiw-card-title text-xl font-semibold leading-snug">{step.title}</h3>
                  <p class="hiw-card-desc text-sm leading-relaxed">{step.description}</p>
                </div>
              </article>
            </li>
          ))
        }
      </ol>

      <div class="flex justify-center pt-2" data-reveal style="--reveal-delay: 450ms">
        <a href={SIGNUP_URL} class="btn btn-primary btn-large">{s.cta}</a>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* ─── Section ───────────────────────────────────────────── */
  .hiw-section {
    position: relative;
    isolation: isolate;
    padding-block: var(--space-6) var(--space-8);
    background: var(--bg-secondary);
    overflow: hidden;
  }

  [data-theme="dark"] .hiw-section {
    background: var(--bg-primary);
  }

  @media (min-width: 1024px) {
    .hiw-section {
      padding-block: var(--space-8) var(--space-10);
    }
  }

  .hiw-section__container {
    position: relative;
    z-index: 1;
  }

  .hiw-section__glow {
    position: absolute;
    width: min(28rem, 50vw);
    height: min(28rem, 50vw);
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.14;
    pointer-events: none;
  }

  .hiw-section__glow--start {
    top: -15%;
    inset-inline-start: -10%;
    background: color-mix(in srgb, var(--color-primary) 22%, transparent);
  }

  .hiw-section__glow--end {
    bottom: -15%;
    inset-inline-end: -8%;
    background: color-mix(in srgb, var(--color-accent) 18%, transparent);
  }

  [data-theme="dark"] .hiw-section__glow {
    opacity: 0.07;
  }

  /* ─── Flow stepper ──────────────────────────────────────── */
  /* Pulsing ring — infinite, cycles per step colour */
  @keyframes hiw-ring-pulse {
    0%, 100% { transform: scale(1);   opacity: 0.45; }
    50%       { transform: scale(1.18); opacity: 0;    }
  }

  .hiw-flow-node__ring {
    position: relative;
    display: inline-flex;
  }

  .hiw-flow-node__ring::before {
    content: "";
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    animation: hiw-ring-pulse 2.4s ease-out infinite;
    pointer-events: none;
  }

  .hiw-flow-node__ring--connect::before { background: rgba(124, 58, 237, 0.35); animation-delay: 0s;    }
  .hiw-flow-node__ring--create::before  { background: rgba(37, 99, 235, 0.35);  animation-delay: 0.8s;  }
  .hiw-flow-node__ring--track::before   { background: rgba(22, 163, 74, 0.35);  animation-delay: 1.6s;  }

  /* ─── Flow bridge (line + arrow) ──────────────────────── */
  .hiw-flow-bridge__bg {
    background: var(--border-primary);
  }

  @keyframes hiw-shimmer-h {
    0%   { transform: translateX(-100%); }
    100% { transform: translateX(200%);  }
  }

  @keyframes hiw-shimmer-h-rtl {
    0%   { transform: translateX(100%); }
    100% { transform: translateX(-200%); }
  }

  @keyframes hiw-shimmer-v {
    0%   { transform: translateY(-100%); }
    100% { transform: translateY(200%);  }
  }

  @keyframes hiw-arrow-nudge {
    0%, 100% { transform: translateX(0);   opacity: 0.55; }
    50%       { transform: translateX(4px); opacity: 1;    }
  }

  @keyframes hiw-arrow-nudge-rtl {
    0%, 100% { transform: scaleX(-1) translateX(0);    opacity: 0.55; }
    50%       { transform: scaleX(-1) translateX(-4px); opacity: 1;     }
  }

  .hiw-flow-bridge__shimmer {
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-primary) 40%,
      #8b5cf6 60%,
      transparent 100%
    );
    animation: hiw-shimmer-h 2s linear infinite;
  }

  .hiw-flow-bridge__shimmer--rtl {
    background: linear-gradient(
      270deg,
      transparent 0%,
      var(--color-primary) 40%,
      #8b5cf6 60%,
      transparent 100%
    );
    animation: hiw-shimmer-h-rtl 2s linear infinite;
  }

  .hiw-flow-bridge__shimmer-vertical {
    background: linear-gradient(
      180deg,
      transparent 0%,
      var(--color-primary) 40%,
      var(--color-accent) 60%,
      transparent 100%
    );
    animation: hiw-shimmer-v 2s linear infinite;
  }

  .hiw-flow-rail {
    align-items: center;
  }

  .hiw-flow-bridge {
    height: 100%;
  }

  .hiw-flow-arrow {
    margin-inline-start: var(--space-2);
    flex-shrink: 0;
    color: var(--color-primary);
    animation: hiw-arrow-nudge 1.6s ease-in-out infinite;
  }

  .hiw-flow-arrow--rtl {
    transform: scaleX(-1);
    animation: hiw-arrow-nudge-rtl 1.6s ease-in-out infinite;
  }

  /* ─── Nodes & badges ──────────────────────────────────── */
  .hiw-node--connect { background: rgba(124, 58, 237, 0.1);  color: #7c3aed; border-color: rgba(124, 58, 237, 0.28); }
  .hiw-node--create  { background: rgba(37, 99, 235, 0.1);   color: #2563eb; border-color: rgba(37, 99, 235, 0.28); }
  .hiw-node--track   { background: rgba(22, 163, 74, 0.1);   color: #16a34a; border-color: rgba(22, 163, 74, 0.28); }

  [data-theme="dark"] .hiw-node--connect { background: rgba(124, 58, 237, 0.15); color: #a78bfa; border-color: rgba(124, 58, 237, 0.35); }
  [data-theme="dark"] .hiw-node--create  { background: rgba(37, 99, 235, 0.15);  color: #60a5fa; border-color: rgba(37, 99, 235, 0.35); }
  [data-theme="dark"] .hiw-node--track   { background: rgba(22, 163, 74, 0.12);  color: #4ade80; border-color: rgba(22, 163, 74, 0.3);  }

  .hiw-badge--connect { background: rgba(124, 58, 237, 0.1);  color: #7c3aed; }
  .hiw-badge--create  { background: rgba(37, 99, 235, 0.1);   color: #2563eb; }
  .hiw-badge--track   { background: rgba(22, 163, 74, 0.1);   color: #16a34a; }

  [data-theme="dark"] .hiw-badge--connect { background: rgba(124, 58, 237, 0.15); color: #a78bfa; }
  [data-theme="dark"] .hiw-badge--create  { background: rgba(37, 99, 235, 0.15);  color: #60a5fa; }
  [data-theme="dark"] .hiw-badge--track   { background: rgba(22, 163, 74, 0.12);  color: #4ade80; }

  /* ─── Cards ───────────────────────────────────────────── */
  .hiw-card {
    position: relative;
    padding: var(--space-6) var(--space-6) var(--space-8);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-primary);
    background: var(--bg-primary);
    overflow: hidden;
    transition:
      border-color var(--transition-base),
      box-shadow var(--transition-base),
      transform var(--transition-base);
  }

  @media (min-width: 1024px) {
    .hiw-card {
      padding: var(--space-8) var(--space-8) var(--space-10);
    }
  }

  .hiw-card::before {
    content: "";
    position: absolute;
    top: 0;
    inset-inline: 0;
    height: 3px;
    border-radius: var(--radius-full) var(--radius-full) 0 0;
  }

  .hiw-step--connect .hiw-card::before { background: linear-gradient(90deg, #7c3aed, #a78bfa); }
  .hiw-step--create  .hiw-card::before { background: linear-gradient(90deg, #2563eb, #60a5fa); }
  .hiw-step--track   .hiw-card::before { background: linear-gradient(90deg, #16a34a, #4ade80); }

  .hiw-card:hover {
    border-color: var(--color-primary-alpha-20);
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  [data-theme="dark"] .hiw-card {
    background: var(--bg-secondary);
  }

  .hiw-card-title {
    color: var(--color-gray-900);
  }

  [data-theme="dark"] .hiw-card-title {
    color: var(--color-gray-50);
  }

  .hiw-card-desc {
    color: var(--color-gray-600);
  }

  [data-theme="dark"] .hiw-card-desc {
    color: var(--color-gray-400);
  }

  .hiw-mobile-bridge .hiw-flow-arrow {
    position: absolute;
    bottom: 0;
    transform: rotate(90deg);
    animation: hiw-arrow-nudge-down 1.6s ease-in-out infinite;
  }

  @keyframes hiw-arrow-nudge-down {
    0%, 100% { transform: rotate(90deg) translateX(0);   opacity: 0.55; }
    50%       { transform: rotate(90deg) translateX(4px); opacity: 1;    }
  }

  /* ─── Reduced motion ──────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .hiw-section__glow,
    .hiw-flow-node__ring::before,
    .hiw-flow-bridge__shimmer,
    .hiw-flow-bridge__shimmer-vertical,
    .hiw-flow-arrow,
    .hiw-mobile-bridge .hiw-flow-arrow {
      animation: none !important;
    }

    .hiw-card {
      transition: none;
    }

    .hiw-card:hover {
      transform: none;
    }
  }
</style>
