---
import SectionHeader from "./SectionHeader.astro";
import { getTranslations, type Locale } from "../i18n";
import { SIGNUP_URL, SITE_URL, getContactHref } from "../config/site";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "ar";
const t = getTranslations(locale);
const { pricingSection: s } = t;

const ctaHrefs = { signup: SIGNUP_URL, contact: getContactHref() } as const;
const siteUrl = Astro.site ?? SITE_URL;

const TRUST_ICONS = {
  local:
    '<path d="M12 2a8 8 0 0 0-8 8c0 5.25 7.22 11.58 7.54 11.84a.75.75 0 0 0 .92 0C12.78 21.58 20 15.25 20 10a8 8 0 0 0-8-8z"/><circle cx="12" cy="10" r="3"/>',
  pricing:
    '<path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r="1"/>',
  ease: '<path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/>',
} as const;

// Only plans with a published price become offers; Enterprise is quote-based.
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Rawafid",
  alternateName: "روافد",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  url: new URL("/", siteUrl).href,
  description: t.meta.description,
  offers: s.plans.flatMap((plan) => {
    if (plan.priceType === "free") {
      return [{ "@type": "Offer", name: plan.name, price: "0", priceCurrency: "EGP" }];
    }
    if (plan.priceType === "numeric" && plan.monthlyPrice) {
      return [
        {
          "@type": "Offer",
          name: plan.name,
          price: plan.monthlyPrice,
          priceCurrency: "EGP",
          priceSpecification: {
            "@type": "UnitPriceSpecification",
            price: plan.monthlyPrice,
            priceCurrency: "EGP",
            unitCode: "MON",
          },
        },
      ];
    }
    return [];
  }),
};
---

<section id="pricing" class="pricing-section" aria-labelledby="pricing-heading" data-pricing>
  <div class="pricing-section__glow pricing-section__glow--start" aria-hidden="true"></div>
  <div class="pricing-section__glow pricing-section__glow--end" aria-hidden="true"></div>

  <div class="container pricing-section__container">
    <div class="flex w-full flex-col gap-10 lg:gap-12">
      <SectionHeader
        id="pricing-heading"
        eyebrow={s.eyebrow}
        headline={s.headline}
        subheadline={s.subheadline}
      />

      <!-- Native radios: keyboard support and state for free; CSS :has() swaps the prices. -->
      <div class="flex w-full flex-col items-center gap-3" data-reveal>
        <div
          class="pricing-toggle relative grid w-full max-w-[22rem] grid-cols-2 gap-1 rounded-full border p-1 sm:max-w-[24rem]"
          role="radiogroup"
          aria-label={s.billing.toggleLabel}
        >
          <span class="pricing-toggle__indicator pointer-events-none absolute inset-y-1 rounded-full" aria-hidden="true"></span>

          <label class="pricing-toggle__btn relative z-[1] flex min-h-[2.75rem] items-center justify-center rounded-full px-4 py-2.5 text-sm font-semibold">
            <input type="radio" name="billing-period" value="monthly" class="visually-hidden" checked data-billing-input />
            <span>{s.billing.monthly}</span>
          </label>

          <label class="pricing-toggle__btn relative z-[1] flex min-h-[2.75rem] flex-col items-center justify-center gap-0.5 rounded-full px-3 py-2 text-sm font-semibold leading-tight">
            <input type="radio" name="billing-period" value="annual" class="visually-hidden" data-billing-input />
            <span>{s.billing.annual}</span>
            <span class="pricing-toggle__save rounded-full px-2 py-px text-[0.625rem] font-bold leading-none tracking-wide">
              {s.billing.annualSave}
            </span>
          </label>
        </div>
      </div>

      <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-billing-status></p>

      <ul class="pricing-grid m-0 w-full list-none p-0" role="list">
        {
          s.plans.map((plan, index) => (
            <li
              class={`pricing-grid__item pricing-grid__item--${plan.id} min-w-0`}
              data-reveal
              style={`--reveal-delay: ${index * 90}ms`}
            >
              <article
                class:list={[
                  `pricing-card pricing-card--${plan.id} group relative flex h-full flex-col`,
                  plan.popular && "pricing-card--popular",
                ]}
                aria-labelledby={`pricing-plan-${plan.id}-name`}
              >
                {plan.popular && plan.popularBadge && (
                  <div class="pricing-card__badge-wrap">
                    <span class="pricing-popular-badge inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-[0.6875rem] font-bold uppercase tracking-wide">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="shrink-0">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                      </svg>
                      {plan.popularBadge}
                    </span>
                  </div>
                )}

                <header class="pricing-card__header flex flex-col gap-4">
                  <div class="flex flex-col gap-1.5">
                    <h3 id={`pricing-plan-${plan.id}-name`} class="pricing-card__name text-xl font-bold">
                      {plan.name}
                    </h3>
                    <p class="pricing-card__tagline text-sm leading-relaxed">{plan.tagline}</p>
                  </div>

                  <div class="pricing-price min-h-[4rem] sm:min-h-[4.5rem]">
                    {plan.priceType === "free" && (
                      <div class="flex flex-col gap-1">
                        <span class="pricing-price__amount text-[2rem] font-bold leading-none tracking-tight sm:text-4xl lg:text-[2.75rem]">
                          {plan.freeLabel}
                        </span>
                        {plan.freeSub && <span class="pricing-price__sub text-sm font-medium">{plan.freeSub}</span>}
                      </div>
                    )}

                    {plan.priceType === "custom" && (
                      <div class="flex flex-col gap-1">
                        <span class="pricing-price__amount text-[2rem] font-bold leading-none tracking-tight sm:text-4xl lg:text-[2.75rem]">
                          {plan.customLabel}
                        </span>
                        {plan.customSub && <span class="pricing-price__sub text-sm font-medium">{plan.customSub}</span>}
                      </div>
                    )}

                    {plan.priceType === "numeric" &&
                      (["monthly", "annual"] as const).map((period) => (
                        <div class={`pricing-price__period pricing-price__period--${period}`}>
                          <div class="flex flex-wrap items-end gap-x-2 gap-y-1">
                            <span
                              class="pricing-price__amount text-[2rem] font-bold tabular-nums leading-none tracking-tight sm:text-4xl lg:text-[2.75rem]"
                              dir="ltr"
                            >
                              {period === "monthly" ? plan.monthlyPrice : plan.annualPrice}
                            </span>
                            {plan.priceSuffix && (
                              <span class="pricing-price__suffix pb-1 text-sm font-medium">{plan.priceSuffix}</span>
                            )}
                          </div>
                          {period === "annual" && plan.annualNote && (
                            <span class="pricing-price__sub mt-1 block text-sm font-medium">{plan.annualNote}</span>
                          )}
                        </div>
                      ))}
                  </div>
                </header>

                <div class="pricing-card__divider" aria-hidden="true"></div>

                <div class="pricing-card__body flex flex-1 flex-col">
                  <p class="visually-hidden">{s.featuresHeading}</p>
                  <ul class="pricing-card__features m-0 flex flex-col gap-3 p-0" role="list">
                    {plan.features.map((feature) => (
                      <li class="pricing-card__feature flex items-start gap-3 text-sm leading-relaxed">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="pricing-check-icon block shrink-0">
                          <path d="M20 6 9 17l-5-5" />
                        </svg>
                        <span>{feature}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <footer class="pricing-card__footer mt-auto">
                  <a
                    href={ctaHrefs[plan.ctaTarget]}
                    class:list={[
                      "btn pricing-card__cta w-full",
                      plan.ctaVariant === "primary" ? "btn-primary" : "btn-secondary",
                    ]}
                  >
                    {plan.cta}
                  </a>
                </footer>
              </article>
            </li>
          ))
        }
      </ul>

      <ul class="pricing-trust" role="list" aria-label={s.trust.label}>
        {
          s.trust.points.map((point, index) => (
            <li class="pricing-trust__item" data-reveal style={`--reveal-delay: ${index * 90}ms`}>
              <span class="pricing-trust__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={TRUST_ICONS[point.icon]} />
              </span>
              <div>
                <p class="pricing-trust__title">{point.title}</p>
                <p class="pricing-trust__desc">{point.description}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

<script define:vars={{ monthly: s.billing.monthly, annual: s.billing.annual, template: s.priceUpdated }}>
  // Announce price changes to screen readers; the visual swap is pure CSS.
  var status = document.querySelector("[data-billing-status]");
  document.querySelectorAll("[data-billing-input]").forEach(function (input) {
    input.addEventListener("change", function () {
      if (status) status.textContent = template.replace("{period}", input.value === "annual" ? annual : monthly);
    });
  });
</script>

<style is:global>
  /* ── Section shell ─────────────────────────────────────────── */
  .pricing-section {
    position: relative;
    isolation: isolate;
    padding-block: var(--space-12) var(--space-16);
    background: var(--bg-primary);
    /* Clip the decorative glows horizontally (they caused page-wide horizontal scroll)
       while keeping the "Most popular" badge visible above the card. */
    overflow-x: clip;
  }

  [data-theme="dark"] .pricing-section {
    background: var(--bg-secondary);
  }

  @media (min-width: 1024px) {
    .pricing-section {
      padding-block: var(--space-16) var(--space-20);
    }
  }

  .pricing-section__container {
    position: relative;
    z-index: 1;
  }

  /* ── Ambient glows ─────────────────────────────────────────── */
  .pricing-section__glow {
    position: absolute;
    width: min(32rem, 58vw);
    height: min(32rem, 58vw);
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.16;
    pointer-events: none;
  }

  .pricing-section__glow--start {
    top: -18%;
    inset-inline-start: -14%;
    background: color-mix(in srgb, var(--color-primary) 24%, transparent);
  }

  .pricing-section__glow--end {
    bottom: -18%;
    inset-inline-end: -12%;
    background: color-mix(in srgb, var(--color-primary) 14%, transparent);
  }

  [data-theme="dark"] .pricing-section__glow {
    opacity: 0.08;
  }

  /* ── Grid ──────────────────────────────────────────────────── */
  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    align-items: stretch;
    padding-block-start: var(--space-4);
  }

  @media (min-width: 768px) {
    .pricing-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5);
    }

    /* Growth (popular) spans full row on tablet, centered */
    .pricing-grid__item--growth {
      grid-column: 1 / -1;
      max-width: 28rem;
      justify-self: center;
      width: 100%;
    }
  }

  @media (min-width: 1024px) {
    .pricing-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
      align-items: stretch;
      padding-block-start: var(--space-5);
    }

    .pricing-grid__item--growth {
      grid-column: auto;
      max-width: none;
    }
  }

  /* ── Billing toggle ─────────────────────────────────────────── */
  .pricing-toggle {
    background: var(--color-gray-100);
    border-color: var(--border-primary);
  }

  [data-theme="dark"] .pricing-toggle {
    background: var(--bg-primary);
    border-color: var(--border-primary);
  }

  .pricing-toggle__btn {
    color: var(--color-gray-600);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: color var(--transition-base);
  }

  .pricing-toggle__btn:has(:focus-visible) {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .pricing-toggle__btn:hover:not(:has(:checked)) {
    color: var(--color-gray-900);
  }

  [data-theme="dark"] .pricing-toggle__btn {
    color: var(--color-gray-400);
  }

  [data-theme="dark"] .pricing-toggle__btn:hover:not(:has(:checked)) {
    color: var(--color-gray-100);
  }

  .pricing-toggle__btn:has(:checked) {
    color: var(--color-gray-900);
  }

  [data-theme="dark"] .pricing-toggle__btn:has(:checked) {
    color: var(--color-gray-50);
  }

  .pricing-toggle__indicator {
    inset-inline-start: 0.25rem;
    width: calc(50% - 0.25rem);
    background: var(--bg-primary);
    box-shadow: var(--shadow-md);
    transition: inset-inline-start 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pricing-toggle:has(input[value="annual"]:checked) .pricing-toggle__indicator {
    inset-inline-start: calc(50% + 0.125rem);
  }

  /* Show the price for the selected billing period. */
  .pricing-section:has(input[value="annual"]:checked) .pricing-price__period--monthly,
  .pricing-section:not(:has(input[value="annual"]:checked)) .pricing-price__period--annual {
    display: none;
  }

  [data-theme="dark"] .pricing-toggle__indicator {
    background: var(--bg-secondary);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.45);
  }

  .pricing-toggle__save {
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
    color: #15803d; /* green-700: AA on the light toggle; accent-dark is ~3:1 */
  }

  [data-theme="dark"] .pricing-toggle__save {
    background: color-mix(in srgb, var(--color-accent) 22%, transparent);
    color: var(--color-accent-light);
  }

  .pricing-toggle__btn:has(:checked) .pricing-toggle__save {
    background: color-mix(in srgb, var(--color-accent) 20%, transparent);
  }

  /* ── Plan cards ─────────────────────────────────────────────── */
  .pricing-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-primary);
    background: var(--bg-primary);
    overflow: hidden;
    transition:
      border-color var(--transition-base),
      box-shadow var(--transition-base),
      transform var(--transition-base);
  }

  @media (min-width: 1024px) {
    .pricing-card {
      padding: var(--space-8);
    }
  }

  /* Brand palette: only the recommended plan gets the primary accent bar. */
  .pricing-card--popular::before {
    content: "";
    position: absolute;
    top: 0;
    inset-inline: 0;
    height: 3px;
    background: var(--color-primary);
  }

  .pricing-card:hover {
    border-color: var(--color-primary-alpha-20);
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
  }

  [data-theme="dark"] .pricing-card {
    background: var(--bg-primary);
    border-color: var(--border-primary);
  }

  [data-theme="dark"] .pricing-card:hover {
    border-color: color-mix(in srgb, var(--color-primary-light) 35%, var(--border-primary));
    box-shadow: var(--shadow-lg);
  }

  .pricing-card--popular {
    border-color: color-mix(in srgb, var(--color-primary) 45%, var(--border-primary));
    box-shadow:
      var(--shadow-md),
      0 0 0 1px color-mix(in srgb, var(--color-primary) 10%, transparent);
  }

  [data-theme="dark"] .pricing-card--popular {
    background: color-mix(in srgb, var(--color-primary) 6%, var(--bg-primary));
    border-color: color-mix(in srgb, var(--color-primary-light) 40%, var(--border-primary));
    box-shadow:
      var(--shadow-lg),
      0 0 0 1px color-mix(in srgb, var(--color-primary-light) 12%, transparent),
      0 0 40px color-mix(in srgb, var(--color-primary) 12%, transparent);
  }

  @media (min-width: 1024px) {
    .pricing-card--popular {
      padding-block: calc(var(--space-8) + 0.25rem);
    }
  }

  /* In-flow: the card clips overflow (rounded accent bar), which used to hide a badge
     positioned above its top edge. */
  .pricing-card__badge-wrap {
    display: flex;
    margin-block-end: var(--space-4);
  }

  /* Spacing lives here: the global unlayered reset cancels Tailwind padding utilities. */
  .pricing-popular-badge {
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    color: var(--color-white);
    line-height: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .pricing-card,
    .pricing-card--popular {
      transform: none !important;
    }
  }

  .pricing-card__header {
    padding-block-start: var(--space-1);
  }

  .pricing-card--popular .pricing-card__header {
    padding-block-start: var(--space-3);
  }

  .pricing-card__name {
    color: var(--color-secondary);
  }

  [data-theme="dark"] .pricing-card__name {
    color: var(--color-gray-50);
  }

  .pricing-card__tagline {
    color: var(--color-gray-500);
  }

  [data-theme="dark"] .pricing-card__tagline {
    color: var(--color-gray-400);
  }

  .pricing-card__divider {
    height: 1px;
    width: 100%;
    margin-block: var(--space-6);
    background: var(--border-primary);
    flex-shrink: 0;
  }

  [data-theme="dark"] .pricing-card__divider {
    background: var(--border-primary);
  }

  .pricing-card__body {
    margin-block-end: var(--space-8);
  }

  .pricing-card__feature {
    color: var(--color-gray-700);
  }

  [data-theme="dark"] .pricing-card__feature {
    color: var(--color-gray-300);
  }

  .pricing-price__amount {
    color: var(--color-secondary);
  }

  [data-theme="dark"] .pricing-price__amount {
    color: var(--color-gray-50);
  }

  .pricing-price__sub,
  .pricing-price__suffix {
    color: var(--color-gray-500);
  }

  [data-theme="dark"] .pricing-price__sub,
  [data-theme="dark"] .pricing-price__suffix {
    color: var(--color-gray-400);
  }

  .pricing-check-icon {
    color: var(--color-primary);
    margin-top: 0.125rem;
  }

  [data-theme="dark"] .pricing-check-icon {
    color: var(--color-primary-light);
  }

  .pricing-card__footer .btn {
    min-height: 2.75rem;
  }

  /* ── Trust strip ────────────────────────────────────────────── */
  .pricing-trust {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .pricing-trust {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }

  .pricing-trust__item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .pricing-trust__icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    background: var(--color-primary-alpha-10);
    color: var(--color-primary);
  }

  .pricing-trust__icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  [data-theme="dark"] .pricing-trust__icon {
    color: var(--color-primary-light);
  }

  .pricing-trust__title {
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--color-gray-900);
  }

  .pricing-trust__desc {
    margin-block-start: var(--space-1);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-gray-600);
  }
</style>
