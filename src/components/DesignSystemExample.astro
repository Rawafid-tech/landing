---
// Design System Component Examples
// This file demonstrates all design system components
---

<div class="design-system-showcase">
  
  <!-- Colors Section -->
  <section class="section">
    <div class="container">
      <h2 class="text-h2 mb-8">Color System</h2>
      
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        <!-- Primary Colors -->
        <div>
          <div style="background: var(--color-primary); height: 80px; border-radius: var(--radius-lg)"></div>
          <p class="text-body-small mt-2">Primary</p>
          <code class="text-xs">#2563EB</code>
        </div>
        
        <!-- Secondary Colors -->
        <div>
          <div style="background: var(--color-secondary); height: 80px; border-radius: var(--radius-lg)"></div>
          <p class="text-body-small mt-2">Secondary</p>
          <code class="text-xs">#0F172A</code>
        </div>
        
        <!-- Accent Colors -->
        <div>
          <div style="background: var(--color-accent); height: 80px; border-radius: var(--radius-lg)"></div>
          <p class="text-body-small mt-2">Accent</p>
          <code class="text-xs">#22C55E</code>
        </div>
        
        <!-- Light Colors -->
        <div>
          <div style="background: var(--color-light); height: 80px; border-radius: var(--radius-lg); border: 1px solid var(--border-primary)"></div>
          <p class="text-body-small mt-2">Light</p>
          <code class="text-xs">#F8FAFC</code>
        </div>
      </div>
    </div>
  </section>

  <!-- Typography Section -->
  <section class="section bg-gray-50">
    <div class="container">
      <h2 class="text-h2 mb-8">Typography</h2>
      
      <div class="space-y-6">
        <div>
          <p class="text-display-1">Display 1 - Hero Headlines</p>
          <code class="text-xs text-gray-500">72px / Bold</code>
        </div>
        
        <div>
          <p class="text-display-2">Display 2 - Section Headers</p>
          <code class="text-xs text-gray-500">60px / Bold</code>
        </div>
        
        <div>
          <p class="text-h1">Heading 1 - Page Titles</p>
          <code class="text-xs text-gray-500">48px / Bold</code>
        </div>
        
        <div>
          <p class="text-h2">Heading 2 - Section Titles</p>
          <code class="text-xs text-gray-500">36px / Semibold</code>
        </div>
        
        <div>
          <p class="text-h3">Heading 3 - Card Titles</p>
          <code class="text-xs text-gray-500">30px / Semibold</code>
        </div>
        
        <div>
          <p class="text-body-large">Body Large - Important text content</p>
          <code class="text-xs text-gray-500">20px / Normal</code>
        </div>
        
        <div>
          <p class="text-body">Body - Regular text content for paragraphs and descriptions</p>
          <code class="text-xs text-gray-500">16px / Normal</code>
        </div>
        
        <div>
          <p class="text-body-small">Body Small - Secondary information</p>
          <code class="text-xs text-gray-500">14px / Normal</code>
        </div>
        
        <div>
          <p class="text-caption">Caption - Labels and small text</p>
          <code class="text-xs text-gray-500">12px / Medium / Uppercase</code>
        </div>
      </div>
    </div>
  </section>

  <!-- Buttons Section -->
  <section class="section">
    <div class="container">
      <h2 class="text-h2 mb-8">Buttons</h2>
      
      <div class="space-y-8">
        <!-- Button Variants -->
        <div>
          <h3 class="text-h4 mb-4">Button Variants</h3>
          <div class="flex flex-wrap gap-4">
            <button class="btn btn-primary">Primary Button</button>
            <button class="btn btn-secondary">Secondary Button</button>
            <button class="btn btn-accent">Accent Button</button>
            <button class="btn btn-ghost">Ghost Button</button>
          </div>
        </div>
        
        <!-- Button Sizes -->
        <div>
          <h3 class="text-h4 mb-4">Button Sizes</h3>
          <div class="flex flex-wrap items-center gap-4">
            <button class="btn btn-primary btn-large">Large Button</button>
            <button class="btn btn-primary">Default Button</button>
            <button class="btn btn-primary btn-small">Small Button</button>
          </div>
        </div>
        
        <!-- Buttons with Icons -->
        <div>
          <h3 class="text-h4 mb-4">Buttons with Icons</h3>
          <div class="flex flex-wrap gap-4">
            <button class="btn btn-primary">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10 5V15M5 10H15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
              Start Free Trial
            </button>
            <button class="btn btn-secondary">
              Learn More
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M7 10L10 13L13 10M10 7V13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cards Section -->
  <section class="section bg-gray-50">
    <div class="container">
      <h2 class="text-h2 mb-8">Cards</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Basic Card -->
        <div class="card">
          <h3 class="text-h4 mb-4">Basic Card</h3>
          <p class="text-body">
            A simple card with hover effects and clean borders.
          </p>
        </div>
        
        <!-- Feature Card -->
        <div class="card-feature">
          <div class="text-5xl mb-4">📦</div>
          <h3 class="text-h4 mb-4">Feature Card</h3>
          <p class="text-body">
            Enhanced card with top border gradient on hover.
          </p>
        </div>
        
        <!-- Card with Glow -->
        <div class="card glow-primary">
          <div class="text-5xl mb-4">✨</div>
          <h3 class="text-h4 mb-4">Glowing Card</h3>
          <p class="text-body">
            Card with primary glow effect.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Animations Section -->
  <section class="section">
    <div class="container">
      <h2 class="text-h2 mb-8">Animations</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="card animate-fade-in">
          <p class="text-h4 mb-2">Fade In</p>
          <code class="text-xs">animate-fade-in</code>
        </div>
        
        <div class="card animate-fade-up">
          <p class="text-h4 mb-2">Fade Up</p>
          <code class="text-xs">animate-fade-up</code>
        </div>
        
        <div class="card">
          <p class="text-h4 mb-2 animate-float">Float</p>
          <code class="text-xs">animate-float</code>
        </div>
        
        <div class="card">
          <p class="text-h4 mb-2 animate-pulse">Pulse</p>
          <code class="text-xs">animate-pulse</code>
        </div>
      </div>
    </div>
  </section>

  <!-- Gradients Section -->
  <section class="section bg-gray-50">
    <div class="container">
      <h2 class="text-h2 mb-8">Gradients</h2>
      
      <div class="space-y-6">
        <div class="gradient-primary p-8 rounded-xl">
          <p class="text-h3 text-white">Primary Gradient</p>
          <code class="text-xs text-white/80">gradient-primary</code>
        </div>
        
        <div class="gradient-dark p-8 rounded-xl">
          <p class="text-h3 text-white">Dark Gradient</p>
          <code class="text-xs text-white/80">gradient-dark</code>
        </div>
        
        <div>
          <h3 class="text-h2 gradient-text">Gradient Text</h3>
          <code class="text-xs">gradient-text</code>
        </div>
      </div>
    </div>
  </section>

  <!-- Glass Effects Section -->
  <section class="section" style="background: linear-gradient(135deg, var(--color-primary), var(--color-accent));">
    <div class="container">
      <h2 class="text-h2 mb-8 text-white">Glass Morphism</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="blur-glass p-8 rounded-xl">
          <h3 class="text-h3 mb-4">Light Glass</h3>
          <p class="text-body">
            Glassmorphism effect with light background and backdrop blur.
          </p>
          <code class="text-xs">blur-glass</code>
        </div>
        
        <div class="blur-glass-dark p-8 rounded-xl">
          <h3 class="text-h3 mb-4 text-white">Dark Glass</h3>
          <p class="text-body text-gray-300">
            Glassmorphism effect with dark background and backdrop blur.
          </p>
          <code class="text-xs text-gray-400">blur-glass-dark</code>
        </div>
      </div>
    </div>
  </section>

  <!-- Spacing Section -->
  <section class="section">
    <div class="container">
      <h2 class="text-h2 mb-8">Spacing System (8pt Grid)</h2>
      
      <div class="space-y-4">
        <div class="flex items-center gap-4">
          <div style="width: var(--space-2); height: 40px; background: var(--color-primary);"></div>
          <code>--space-2 (8px)</code>
        </div>
        <div class="flex items-center gap-4">
          <div style="width: var(--space-4); height: 40px; background: var(--color-primary);"></div>
          <code>--space-4 (16px)</code>
        </div>
        <div class="flex items-center gap-4">
          <div style="width: var(--space-6); height: 40px; background: var(--color-primary);"></div>
          <code>--space-6 (24px)</code>
        </div>
        <div class="flex items-center gap-4">
          <div style="width: var(--space-8); height: 40px; background: var(--color-primary);"></div>
          <code>--space-8 (32px)</code>
        </div>
        <div class="flex items-center gap-4">
          <div style="width: var(--space-12); height: 40px; background: var(--color-primary);"></div>
          <code>--space-12 (48px)</code>
        </div>
      </div>
    </div>
  </section>

  <!-- Shadows Section -->
  <section class="section bg-gray-50">
    <div class="container">
      <h2 class="text-h2 mb-8">Shadow System</h2>
      
      <div class="grid grid-cols-2 md:grid-cols-3 gap-8">
        <div class="bg-white p-6 rounded-xl" style="box-shadow: var(--shadow-xs);">
          <p class="text-body-small">Extra Small</p>
          <code class="text-xs">--shadow-xs</code>
        </div>
        <div class="bg-white p-6 rounded-xl" style="box-shadow: var(--shadow-sm);">
          <p class="text-body-small">Small</p>
          <code class="text-xs">--shadow-sm</code>
        </div>
        <div class="bg-white p-6 rounded-xl" style="box-shadow: var(--shadow-base);">
          <p class="text-body-small">Base</p>
          <code class="text-xs">--shadow-base</code>
        </div>
        <div class="bg-white p-6 rounded-xl" style="box-shadow: var(--shadow-md);">
          <p class="text-body-small">Medium</p>
          <code class="text-xs">--shadow-md</code>
        </div>
        <div class="bg-white p-6 rounded-xl" style="box-shadow: var(--shadow-lg);">
          <p class="text-body-small">Large</p>
          <code class="text-xs">--shadow-lg</code>
        </div>
        <div class="bg-white p-6 rounded-xl" style="box-shadow: var(--shadow-xl);">
          <p class="text-body-small">Extra Large</p>
          <code class="text-xs">--shadow-xl</code>
        </div>
      </div>
    </div>
  </section>

</div>

<style>
  .space-y-6 > * + * {
    margin-top: var(--space-6);
  }
  
  .space-y-8 > * + * {
    margin-top: var(--space-8);
  }
</style>
