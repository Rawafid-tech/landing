---
import SolutionSectionContent from "./react-bits/SolutionSectionContent";
import { getTranslations, type Locale } from "../i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "ar";
const t = getTranslations(locale);
const { solutionSection } = t;
---

<section
  id="solution"
  class="solution-section"
  aria-label={solutionSection.ariaLabel}
>
  <!-- Decorative ambient glows -->
  <div class="solution-section__glow solution-section__glow--start" aria-hidden="true"></div>
  <div class="solution-section__glow solution-section__glow--end" aria-hidden="true"></div>

  <div class="container solution-section__container">
    <SolutionSectionContent
      client:visible
      eyebrow={solutionSection.eyebrow}
      headline={solutionSection.headline}
      subheadline={solutionSection.subheadline}
      beforeLabel={solutionSection.beforeLabel}
      afterLabel={solutionSection.afterLabel}
      pairs={solutionSection.pairs}
    />
  </div>
</section>

<style is:global>
  /* ─── Section shell ──────────────────────────────────────── */
  .solution-section {
    position: relative;
    isolation: isolate;
    padding-block: var(--space-12) var(--space-16);
    background: var(--bg-primary);
    overflow: hidden;
  }

  [data-theme="dark"] .solution-section {
    background: var(--bg-secondary);
  }

  @media (min-width: 1024px) {
    .solution-section {
      padding-block: var(--space-16) var(--space-20);
    }
  }

  .solution-section__container {
    position: relative;
    z-index: 1;
  }

  /* ─── Ambient glow decorations ───────────────────────────── */
  .solution-section__glow {
    position: absolute;
    width: min(26rem, 50vw);
    height: min(26rem, 50vw);
    border-radius: 50%;
    filter: blur(72px);
    opacity: 0.28;
    pointer-events: none;
  }

  .solution-section__glow--start {
    top: -35%;
    inset-inline-start: -10%;
    background: color-mix(in srgb, var(--color-accent) 22%, transparent);
  }

  .solution-section__glow--end {
    bottom: -40%;
    inset-inline-end: -8%;
    background: color-mix(in srgb, var(--color-primary) 18%, transparent);
  }

  [data-theme="dark"] .solution-section__glow {
    opacity: 0.16;
  }

  /* ─── Panel card ─────────────────────────────────────────── */
  .solution-panel {
    /* Shared arrow column width — keeps header and rows perfectly aligned */
    --solution-arrow-col: 2.75rem;
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: var(--bg-primary);
  }

  [data-theme="dark"] .solution-panel {
    background: var(--bg-primary);
    border-color: var(--border-primary);
    box-shadow: var(--shadow-lg);
  }

  /* ─── Column header labels ───────────────────────────────── */
  .solution-panel__labels {
    display: grid;
    /* Mobile: two equal columns, spacer hidden */
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .solution-panel__label-spacer {
    display: none;
  }

  .solution-panel__label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    padding: var(--space-3) var(--space-5);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  @media (min-width: 640px) {
    /* Same 3-column track as data rows */
    .solution-panel__labels {
      grid-template-columns: minmax(0, 1fr) var(--solution-arrow-col) minmax(0, 1fr);
    }

    .solution-panel__label-spacer {
      display: block;
      width: 100%;
      /* Same tint as "قبل روافد" so it reads as one header block */
      background: color-mix(in srgb, #ef4444 7%, var(--bg-secondary));
    }

    [data-theme="dark"] .solution-panel__label-spacer {
      background: color-mix(in srgb, #ef4444 10%, var(--bg-secondary));
    }

    .solution-panel__label {
      padding: var(--space-4) var(--space-6);
      font-size: var(--text-sm);
    }
  }

  .solution-panel__label--before {
    background: color-mix(in srgb, #ef4444 7%, var(--bg-secondary));
    color: #b91c1c;
  }

  [data-theme="dark"] .solution-panel__label--before {
    background: color-mix(in srgb, #ef4444 10%, var(--bg-secondary));
    color: #fca5a5;
  }

  .solution-panel__label--after {
    background: color-mix(in srgb, var(--color-accent) 7%, var(--bg-secondary));
    color: var(--color-accent-dark);
  }

  @media (min-width: 640px) {
    .solution-panel__label--after {
      border-inline-start: 1px solid var(--border-primary);
    }
  }

  [data-theme="dark"] .solution-panel__label--after {
    background: color-mix(in srgb, var(--color-accent) 9%, var(--bg-secondary));
    color: var(--color-accent-light);
  }

  .solution-panel__label-dot {
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: var(--radius-full);
    flex-shrink: 0;
  }

  .solution-panel__label-dot--before {
    background: #ef4444;
  }

  .solution-panel__label-dot--after {
    background: var(--color-accent);
  }

  /* ─── Separator ──────────────────────────────────────────── */
  .solution-panel__separator {
    height: 1px;
    background: var(--border-primary);
  }

  /* ─── Rows ───────────────────────────────────────────────── */
  .solution-panel__rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .solution-panel__row {
    display: grid;
    /* Mobile: stack before / arrow / after vertically */
    grid-template-columns: 1fr;
    grid-template-rows: auto auto auto;
    padding: var(--space-4) var(--space-5);
    gap: var(--space-2);
    transition: background-color var(--transition-base);
  }

  .solution-panel__row:not(:last-child) {
    border-block-end: 1px solid var(--border-primary);
  }

  /* Tablet+: side-by-side layout */
  @media (min-width: 640px) {
    .solution-panel__row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) var(--solution-arrow-col) minmax(0, 1fr);
      grid-template-rows: 1fr;
      align-items: center;
      padding: 0;
      gap: 0;
    }

    .solution-panel__row:hover {
      background: color-mix(in srgb, var(--color-primary) 3%, var(--bg-primary));
    }

    [data-theme="dark"] .solution-panel__row:hover {
      background: color-mix(in srgb, var(--color-primary) 6%, var(--bg-secondary));
    }
  }

  /* ─── Cells ──────────────────────────────────────────────── */
  .solution-panel__cell {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    padding: var(--space-3) 0;
  }

  @media (min-width: 640px) {
    .solution-panel__cell {
      align-items: center;
      padding: var(--space-4) var(--space-5);
    }
  }

  @media (min-width: 1024px) {
    .solution-panel__cell {
      padding: var(--space-5) var(--space-6);
    }
  }

  .solution-panel__cell--after {
    /* Divider between cells on tablet+ */
  }

  @media (min-width: 640px) {
    .solution-panel__cell--after {
      border-inline-start: 1px solid var(--border-primary);
    }
  }

  /* ─── Cell icons ─────────────────────────────────────────── */
  .solution-panel__cell-icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 1.125rem;
    height: 1.125rem;
    /* Slight top nudge so icon aligns with the first text line */
    margin-block-start: 0.1em;
  }

  @media (min-width: 640px) {
    .solution-panel__cell-icon {
      margin-block-start: 0;
    }
  }

  .solution-panel__cell-icon--before {
    color: #ef4444;
  }

  [data-theme="dark"] .solution-panel__cell-icon--before {
    color: #fca5a5;
  }

  .solution-panel__cell-icon--after {
    color: var(--color-accent-dark);
  }

  [data-theme="dark"] .solution-panel__cell-icon--after {
    color: var(--color-accent-light);
  }

  .solution-cell-icon__svg {
    width: 100%;
    height: 100%;
  }

  /* ─── Cell text ──────────────────────────────────────────── */
  .solution-panel__cell-text {
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  @media (min-width: 640px) {
    .solution-panel__cell-text {
      font-size: var(--text-base);
    }
  }

  .solution-panel__cell--before .solution-panel__cell-text {
    color: var(--color-gray-500);
  }

  [data-theme="dark"] .solution-panel__cell--before .solution-panel__cell-text {
    color: var(--color-gray-500);
  }

  .solution-panel__cell--after .solution-panel__cell-text {
    font-weight: var(--font-medium);
    color: var(--color-gray-900);
  }

  [data-theme="dark"] .solution-panel__cell--after .solution-panel__cell-text {
    color: var(--color-gray-100);
  }

  /* ─── Arrow connector ────────────────────────────────────── */
  .solution-panel__arrow {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    /* On mobile, indent to align with cell content (icon width + gap) */
    padding-inline-start: calc(1.125rem + var(--space-3));
    color: var(--color-gray-300);
  }

  [data-theme="dark"] .solution-panel__arrow {
    color: var(--color-gray-600);
  }

  @media (min-width: 640px) {
    .solution-panel__arrow {
      width: var(--solution-arrow-col);
      flex-shrink: 0;
      padding-inline: 0;
      justify-content: center;
      border-inline-start: 1px solid var(--border-primary);
    }
  }

  .solution-arrow__svg {
    width: 1rem;
    height: 1rem;
    /* On mobile: arrow points down */
    transform: rotate(90deg);
    transition: transform var(--transition-base);
  }

  @media (min-width: 640px) {
    .solution-arrow__svg {
      width: 1.125rem;
      height: 1.125rem;
      /* Tablet+: arrow points right (LTR default) */
      transform: none;
    }
  }

  /* RTL: flip arrow horizontally on tablet+ so it points left */
  [dir="rtl"] .solution-arrow__svg {
    transform: scaleX(-1);
  }

  /* RTL on mobile: keep pointing down (override the rtl flip) */
  @media (max-width: 639px) {
    [dir="rtl"] .solution-arrow__svg {
      transform: rotate(90deg);
    }
  }

  /* ─── Reduced motion ─────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .solution-section__glow {
      display: none;
    }

    .solution-panel__row {
      transition: none;
    }

    .solution-arrow__svg {
      transition: none;
    }
  }
</style>
