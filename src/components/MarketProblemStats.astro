---
import { getTranslations, type Locale } from "../i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "ar";
const t = getTranslations(locale);
const s = t.marketStats;

type StatIcon = (typeof s.stats)[number]["icon"] | "insights";

const ICONS: Record<StatIcon, string> = {
  insights: '<path d="M3 3v18h18"/><path d="M7 16l4-5 4 3 5-7"/>',
  merchants:
    '<path d="M16 19v-1a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v1"/><circle cx="9" cy="7" r="3.25"/><path d="M22 19v-1a3 3 0 0 0-2.2-2.87"/><path d="M16 3.3a3.25 3.25 0 0 1 0 6.3"/>',
  carriers:
    '<path d="M14 18V7.2a1.2 1.2 0 0 0-1.2-1.2H3.2A1.2 1.2 0 0 0 2 7.2V16a1 1 0 0 0 1 1h1.2"/><path d="M15 18h3.3"/><path d="M19.8 18H21a1 1 0 0 0 1-1v-2.8a1 1 0 0 0-.76-.97l-1.8-.54a1.2 1.2 0 0 1-.84-1.14V10a1 1 0 0 0-1-1h-1.8"/><circle cx="6.5" cy="18" r="1.5"/><circle cx="17.5" cy="18" r="1.5"/>',
  time: '<circle cx="12" cy="12" r="8.25"/><path d="M12 8v4.2l2.8 1.6"/>',
  market: '<path d="M4 19V11"/><path d="M10 19V5"/><path d="M16 19v-7"/><path d="M22 19V8"/>',
};
---

<section id="market-stats" class="market-stats" aria-labelledby="market-stats-heading">
  <div class="market-stats__fade" aria-hidden="true"></div>
  <div class="market-stats__glow market-stats__glow--start" aria-hidden="true"></div>
  <div class="market-stats__glow market-stats__glow--end" aria-hidden="true"></div>

  <div class="container market-stats__container">
    <div class="market-stats__panel">
      <div class="relative flex flex-col gap-8 md:gap-10">
        <div class="market-stats__header" data-reveal>
          <h2 id="market-stats-heading" class="market-stats__eyebrow">
            <span class="market-stats__eyebrow-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS.insights} />
            </span>
            <span>{s.eyebrow}</span>
          </h2>
        </div>

        <!-- Final values are in the HTML; each item reads as one sentence ("85% of merchants struggle…"). -->
        <ul class="market-stats__grid" role="list">
          {
            s.stats.map((stat, index) => (
              <li class="market-stats__item-wrap" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
                <div class="market-stats__item group">
                  <div class={`market-stats__icon market-stats__icon--${stat.icon}`} aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[stat.icon]} />
                  </div>

                  <p class="market-stats__figure inline-flex flex-wrap items-baseline gap-x-1.5 text-[clamp(2.5rem,6vw,3.25rem)] font-bold leading-none tracking-tight text-[var(--color-gray-900)]">
                    <span class="market-stats__value tabular-nums">
                      {stat.prefix}
                      {stat.value}
                    </span>
                    {stat.suffix && <span class="text-[0.72em] font-bold text-[var(--color-primary)]">{stat.suffix}</span>}
                    {stat.unit && (
                      <span class="text-[0.38em] font-semibold tracking-normal text-[var(--color-gray-600)]">{stat.unit}</span>
                    )}
                  </p>

                  <p class="market-stats__labels">
                    <span class="block text-base font-semibold leading-snug text-[var(--color-gray-800)]">
                      {stat.labelPrimary}
                    </span>
                    <span class="block text-sm leading-relaxed text-[var(--color-gray-500)]">{stat.labelSecondary}</span>
                  </p>
                </div>
              </li>
            ))
          }
        </ul>

        {s.source && <p class="market-stats__source">{s.source}</p>}
      </div>
    </div>
  </div>
</section>

<style is:global>
  .market-stats {
    position: relative;
    isolation: isolate;
    padding-block: var(--space-5) var(--space-6);
    overflow: hidden;
  }

  .market-stats__fade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-primary) 6%, transparent) 0%,
        transparent 42%
      ),
      var(--bg-primary);
    pointer-events: none;
  }

  .market-stats__glow {
    position: absolute;
    width: min(28rem, 55vw);
    height: min(28rem, 55vw);
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.35;
    pointer-events: none;
  }

  .market-stats__glow--start {
    top: -40%;
    inset-inline-start: -12%;
    background: color-mix(in srgb, var(--color-primary) 22%, transparent);
  }

  .market-stats__glow--end {
    bottom: -45%;
    inset-inline-end: -10%;
    background: color-mix(in srgb, var(--color-accent) 18%, transparent);
  }

  [data-theme="dark"] .market-stats__glow {
    opacity: 0.22;
  }

  .market-stats__container {
    position: relative;
    z-index: 1;
  }

  .market-stats__panel {
    border: 1px solid color-mix(in srgb, var(--color-primary) 14%, var(--border-primary));
    border-radius: var(--radius-2xl);
    background:
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--bg-primary) 92%, var(--color-primary) 8%) 0%,
        color-mix(in srgb, var(--bg-primary) 96%, transparent) 100%
      );
    box-shadow:
      var(--shadow-lg),
      inset 0 1px 0 color-mix(in srgb, var(--color-white) 40%, transparent);
    backdrop-filter: blur(12px);
    padding: clamp(var(--space-8), 4vw, var(--space-12));
  }

  [data-theme="dark"] .market-stats__panel {
    background:
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--bg-secondary) 88%, var(--color-primary) 12%) 0%,
        color-mix(in srgb, var(--bg-primary) 94%, transparent) 100%
      );
    box-shadow:
      var(--shadow-lg),
      inset 0 1px 0 color-mix(in srgb, var(--color-white) 8%, transparent);
  }

  .market-stats__header {
    display: flex;
    justify-content: center;
  }

  .market-stats__eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    max-width: 100%;
    margin: 0;
    padding: 0;
    font-size: clamp(var(--text-lg), 2.4vw, var(--text-2xl));
    font-weight: var(--font-semibold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--color-gray-900);
    text-wrap: balance;
    text-align: center;
  }

  [data-theme="dark"] .market-stats__eyebrow {
    color: var(--color-gray-50);
  }

  .market-stats__eyebrow-icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-lg);
    border: 1px solid color-mix(in srgb, var(--color-primary) 22%, var(--border-primary));
    background: linear-gradient(
      145deg,
      color-mix(in srgb, var(--color-primary) 14%, var(--bg-primary)) 0%,
      color-mix(in srgb, var(--color-primary) 6%, var(--bg-primary)) 100%
    );
    color: var(--color-primary);
    box-shadow: var(--shadow-sm);
  }

  .market-stats__eyebrow-icon svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  [data-theme="dark"] .market-stats__eyebrow-icon {
    color: #93c5fd;
    border-color: color-mix(in srgb, var(--color-primary) 34%, var(--border-primary));
    background: linear-gradient(
      145deg,
      color-mix(in srgb, var(--color-primary) 24%, var(--bg-secondary)) 0%,
      color-mix(in srgb, var(--color-primary) 10%, var(--bg-primary)) 100%
    );
  }

  .market-stats__icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: var(--space-4);
    border-radius: var(--radius-xl);
    border: 1px solid color-mix(in srgb, var(--color-primary) 18%, var(--border-primary));
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--color-primary) 12%, var(--bg-primary)) 0%,
      color-mix(in srgb, var(--bg-primary) 96%, transparent) 100%
    );
    color: var(--color-primary);
    box-shadow:
      var(--shadow-sm),
      inset 0 1px 0 color-mix(in srgb, var(--color-white) 55%, transparent);
  }

  .market-stats__icon svg {
    width: 1.375rem;
    height: 1.375rem;
    stroke-width: 1.65;
  }

  [data-theme="dark"] .market-stats__icon {
    color: #93c5fd;
    border-color: color-mix(in srgb, var(--color-primary) 32%, var(--border-primary));
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--color-primary) 22%, var(--bg-secondary)) 0%,
      color-mix(in srgb, var(--bg-primary) 92%, transparent) 100%
    );
    box-shadow:
      var(--shadow-sm),
      inset 0 1px 0 color-mix(in srgb, var(--color-white) 10%, transparent);
  }

  .market-stats__icon--merchants {
    color: var(--color-primary);
  }







  .market-stats__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .market-stats__item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-inline: var(--space-2);
  }

  .market-stats__item-wrap:not(:last-child) .market-stats__item::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-end: calc(var(--space-8) * -0.5);
    height: 1px;
    background: var(--border-primary);
  }

  .market-stats__value {
    background: linear-gradient(
      180deg,
      var(--color-gray-900) 0%,
      color-mix(in srgb, var(--color-gray-900) 72%, var(--color-primary)) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  [data-theme="dark"] .market-stats__value {
    background: linear-gradient(
      180deg,
      var(--color-gray-50) 0%,
      color-mix(in srgb, var(--color-gray-50) 70%, var(--color-primary-light)) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @media (min-width: 640px) {
    .market-stats__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-10) var(--space-8);
    }

    .market-stats__item-wrap:not(:last-child) .market-stats__item::after {
      display: none;
    }

    .market-stats__item-wrap:nth-child(odd):not(:last-child) .market-stats__item::before {
      content: "";
      position: absolute;
      inset-inline-end: calc(var(--space-4) * -1);
      top: 8%;
      height: 84%;
      width: 1px;
      background: var(--border-primary);
    }

    .market-stats__item-wrap:nth-child(-n + 2) .market-stats__item {
      padding-block-end: var(--space-2);
      border-block-end: 1px solid var(--border-primary);
    }
  }

  @media (min-width: 1024px) {
    .market-stats {
      padding-block: var(--space-6) var(--space-10);
    }

    .market-stats__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
    }

    .market-stats__item-wrap:nth-child(-n + 2) .market-stats__item {
      padding-block-end: 0;
      border-block-end: none;
    }

    .market-stats__item-wrap:not(:last-child) .market-stats__item::before {
      content: "";
      position: absolute;
      inset-inline-end: 0;
      top: 10%;
      height: 80%;
      width: 1px;
      background: var(--border-primary);
    }

    .market-stats__item-wrap:nth-child(odd):not(:last-child) .market-stats__item::before {
      inset-inline-end: 0;
    }

    .market-stats__item {
      align-items: flex-start;
      text-align: start;
      min-height: 100%;
      padding-inline-end: clamp(var(--space-6), 2.5vw, var(--space-10));
      margin-inline-end: clamp(var(--space-6), 2.5vw, var(--space-10));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .market-stats__glow {
      display: none;
    }
  }

  .market-stats__grid {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .market-stats__figure {
    margin-block-end: var(--space-3);
  }

  .market-stats__labels {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .market-stats__source {
    font-size: var(--text-xs);
    text-align: center;
    color: var(--color-gray-500);
  }
</style>
