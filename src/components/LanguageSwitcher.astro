---
import {
  getAlternateLocale,
  getLocalePath,
  getTranslations,
  localeConfig,
  type Locale,
} from "../i18n";

interface Props {
  locale: Locale;
  variant?: "compact" | "full";
}

const { locale, variant = "compact" } = Astro.props;
const t = getTranslations(locale);
const alternateLocale = getAlternateLocale(locale);
const alternatePath = getLocalePath(alternateLocale);
const label = locale === "ar" ? t.lang.switchToEn : t.lang.switchToAr;
const display = locale === "ar" ? t.lang.shortEn : t.lang.shortAr;
---

<a
  href={alternatePath}
  class:list={["lang-switcher", variant === "full" && "lang-switcher--full"]}
  aria-label={label}
  hreflang={alternateLocale}
  lang={alternateLocale}
  rel="alternate"
  data-lang-switcher
>
  <span class="lang-switcher__icon" aria-hidden="true">
    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.75"
        d="M12 21a9 9 0 100-18 9 9 0 000 18z"
      ></path>
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.75"
        d="M3.6 9h16.8M3.6 15h16.8M12 3c-2.2 2.4-3.3 5.1-3.3 9s1.1 6.6 3.3 9c2.2-2.4 3.3-5.1 3.3-9s-1.1-6.6-3.3-9z"
      ></path>
    </svg>
  </span>
  <span class="lang-switcher__label">{display}</span>
  <span class="visually-hidden">
    ({localeConfig[alternateLocale].htmlLang})
  </span>
</a>

<script>
  import { isLocale, type Locale } from "../i18n";

  const LOCALE_STORAGE_KEY = "rawafid-locale";

  const saveLocalePreference = (event: Event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const link = target.closest<HTMLAnchorElement>("[data-lang-switcher]");
    if (!link) return;

    const href = link.getAttribute("href") ?? "/";
    const nextLocale: Locale = href.startsWith("/en") ? "en" : "ar";
    if (isLocale(nextLocale)) {
      localStorage.setItem(LOCALE_STORAGE_KEY, nextLocale);
    }
  };

  document.addEventListener("click", saveLocalePreference);
</script>
