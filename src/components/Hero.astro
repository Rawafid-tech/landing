---
import { getImage } from "astro:assets";
import heroArLight from "../assets/hero/hero-ar-light.png";
import heroArDark from "../assets/hero/hero-ar-dark.png";
import heroEnLight from "../assets/hero/hero-en-light.png";
import heroEnDark from "../assets/hero/hero-en-dark.png";
import { getTranslations, type Locale } from "../i18n";
import { SIGNUP_URL } from "../config/site";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "ar";
const t = getTranslations(locale);
const hero = t.hero;
const integrations = t.integrationsSection;
const worksWith = [...integrations.stores, ...integrations.couriers]
  .filter((item) => item.icon !== "api")
  .map((item) => item.name);

// Mock-ups of the real dashboard, generated by design/mockups/render.mjs
const heroSources = {
  ar: { light: heroArLight, dark: heroArDark },
  en: { light: heroEnLight, dark: heroEnDark },
}[locale];

const heroWidths = [640, 896] as const;
const heroImageSizes = "(max-width: 640px) 100vw, (max-width: 1024px) min(90vw, 896px), 896px";

async function buildHeroImage(src: ImageMetadata) {
  const aspectRatio = src.width / src.height;
  const [avifImages, webpImages] = await Promise.all(
    (["avif", "webp"] as const).map((format) =>
      Promise.all(
        heroWidths.map((width) =>
          getImage({
            src,
            width,
            height: Math.round(width / aspectRatio),
            format,
            quality: format === "avif" ? 62 : 80,
          }),
        ),
      ),
    ),
  );

  const toSrcSet = (images: typeof avifImages) =>
    images.map((image, index) => `${image.src} ${heroWidths[index]}w`).join(", ");
  const fallback = webpImages[webpImages.length - 1];

  return {
    avifSrcSet: toSrcSet(avifImages),
    webpSrcSet: toSrcSet(webpImages),
    fallbackSrc: fallback.src,
    width: Number(fallback.attributes.width),
    height: Number(fallback.attributes.height),
  };
}

const [heroLight, heroDark] = await Promise.all([
  buildHeroImage(heroSources.light),
  buildHeroImage(heroSources.dark),
]);
---

<section id="hero" class="hero" aria-labelledby="hero-heading">
  <div class="hero-background" aria-hidden="true">
    <div class="hero-background__mesh"></div>
    <div class="hero-background__grid"></div>
    <div class="hero-background__glow hero-background__glow--primary" data-parallax="-1"></div>
    <div class="hero-background__glow hero-background__glow--accent" data-parallax="0.65"></div>
  </div>

  <div class="hero__container container">
    <div class="hero__content">
      <p class="hero__badge">
        <span class="hero__badge-inner">{hero.badge}</span>
      </p>

      <h1 id="hero-heading" class="hero__headline">
        <span class="hero__headline-line">{hero.headline}</span>
        <span class="hero__headline-accent">{hero.headlineAccent}</span>
      </h1>

      <p class="hero__subheadline">{hero.subheadline}</p>

      <div class="hero__actions">
        <a href={SIGNUP_URL} class="btn btn-primary btn-large hero__cta-primary">
          {hero.ctaPrimary}
        </a>
        <a href="#demo" class="btn btn-secondary btn-large hero__cta-secondary">
          {hero.ctaSecondary}
        </a>
      </div>

      <ul class="hero__trust-list" role="list" aria-label={hero.trustListLabel}>
        {
          hero.trustBadges.map((item) => (
            <li class="hero__trust-item">
              <svg class="hero__trust-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"
                />
              </svg>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>

      <div class="hero__works-with">
        <p class="hero__works-with-label" id="hero-works-with">{hero.worksWithLabel}</p>
        <ul class="hero__works-with-list" role="list" aria-labelledby="hero-works-with">
          {worksWith.map((name) => <li class="hero__works-with-item" dir="ltr">{name}</li>)}
        </ul>
      </div>
    </div>

    <div class="hero-dashboard">
      <div class="hero-dashboard__frame">
        <div class="hero-dashboard__shadow" aria-hidden="true"></div>

        <div class="hero-dashboard__card">
          <div class="hero-dashboard__browser-bar" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>

          <!--
            LCP image. Dark sources follow the OS preference so the preload scanner fetches
            the right variant; the inline script below re-points them when the user has
            picked a theme that differs from the OS.
          -->
          <picture data-hero-picture>
            <source
              type="image/avif"
              media="(prefers-color-scheme: dark)"
              srcset={heroDark.avifSrcSet}
              sizes={heroImageSizes}
              data-theme-source="dark"
            />
            <source
              type="image/webp"
              media="(prefers-color-scheme: dark)"
              srcset={heroDark.webpSrcSet}
              sizes={heroImageSizes}
              data-theme-source="dark"
            />
            <source type="image/avif" srcset={heroLight.avifSrcSet} sizes={heroImageSizes} />
            <source type="image/webp" srcset={heroLight.webpSrcSet} sizes={heroImageSizes} />
            <img
              src={heroLight.fallbackSrc}
              alt={hero.dashboardAlt}
              width={heroLight.width}
              height={heroLight.height}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="hero-dashboard__image"
            />
          </picture>
          <script is:inline>
            (function () {
              var picture = document.querySelector("[data-hero-picture]");
              if (!picture) return;
              var root = document.documentElement;
              var sync = function () {
                var dark = root.getAttribute("data-theme") === "dark";
                picture.querySelectorAll('[data-theme-source="dark"]').forEach(function (source) {
                  source.media = dark ? "all" : "not all";
                });
              };
              sync();
              new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ["data-theme"] });
            })();
          </script>
        </div>

        {
          hero.floatingIcons.map((icon) => (
            <div class={`hero-dashboard__float hero-dashboard__float--${icon.position}`} aria-hidden="true">
              <span class="hero-dashboard__float-emoji">{icon.emoji}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  // Subtle pointer parallax for the dashboard and glows. Runs only for fine pointers with
  // motion allowed, only while the hero is on screen, and stops once the motion settles.
  const hero = document.getElementById("hero");
  const finePointer = window.matchMedia("(pointer: fine)");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (hero && finePointer.matches && !reducedMotion.matches) {
    const TILT = 3.5;
    const SHIFT = 16;
    const EASE = 0.08;

    const frame = hero.querySelector<HTMLElement>(".hero-dashboard__frame");
    const layers = [...hero.querySelectorAll<HTMLElement>("[data-parallax]")];
    const target = { x: 0, y: 0 };
    const current = { x: 0, y: 0 };
    let rafId = 0;
    let inView = true;

    const render = () => {
      const { x, y } = current;
      if (frame) {
        frame.style.setProperty("--tilt-x", `${(y * -TILT).toFixed(3)}deg`);
        frame.style.setProperty("--tilt-y", `${(x * TILT).toFixed(3)}deg`);
        frame.style.setProperty("--parallax-x", `${(x * SHIFT * 0.35).toFixed(2)}px`);
        frame.style.setProperty("--parallax-y", `${(y * SHIFT * 0.3).toFixed(2)}px`);
      }
      layers.forEach((layer) => {
        const factor = Number(layer.dataset.parallax) || 0;
        layer.style.transform = `translate3d(${(x * SHIFT * factor).toFixed(2)}px, ${(y * SHIFT * factor * 0.8).toFixed(2)}px, 0)`;
      });
    };

    const tick = () => {
      current.x += (target.x - current.x) * EASE;
      current.y += (target.y - current.y) * EASE;
      render();

      const settled = Math.abs(target.x - current.x) < 0.001 && Math.abs(target.y - current.y) < 0.001;
      rafId = settled || !inView ? 0 : requestAnimationFrame(tick);
    };

    const start = () => {
      if (!rafId && inView) rafId = requestAnimationFrame(tick);
    };

    hero.addEventListener(
      "pointermove",
      (event) => {
        const rect = hero.getBoundingClientRect();
        target.x = (event.clientX - rect.left) / rect.width - 0.5;
        target.y = (event.clientY - rect.top) / rect.height - 0.5;
        start();
      },
      { passive: true },
    );

    hero.addEventListener("pointerleave", () => {
      target.x = 0;
      target.y = 0;
      start();
    });

    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      if (inView) start();
    }).observe(hero);
  }
</script>

<style is:global>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block:
      calc(env(safe-area-inset-top, 0px) + 6.5rem)
      var(--space-8);
    min-height: min(100dvh, 56rem);
    display: flex;
    align-items: center;
  }

  .hero__container {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-12);
    align-items: center;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-6);
    max-width: 46rem;
    margin-inline: auto;
    order: 1;
  }

  .hero__badge {
    display: inline-flex;
    margin: 0;
  }

  .hero__badge-inner {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    border: 1px solid var(--color-primary-alpha-20);
    background: color-mix(in srgb, var(--color-primary) 8%, var(--bg-primary));
    color: var(--color-primary-dark);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    box-shadow: var(--shadow-sm);
  }

  [data-theme="dark"] .hero__badge-inner {
    color: var(--color-primary-light);
    background: color-mix(in srgb, var(--color-primary) 16%, var(--bg-primary));
    border-color: var(--color-primary-alpha-20);
  }

  .hero__headline {
    display: block;
    width: 100%;
    font-size: clamp(var(--text-3xl), 4.5vw, var(--text-5xl));
    font-weight: var(--font-bold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--color-gray-900);
  }

  [data-theme="dark"] .hero__headline {
    color: var(--color-gray-50);
  }

  .hero__headline-line {
    display: block;
  }

  .hero__headline-accent {
    display: block;
    margin-block-start: 0.15em;
    color: var(--color-primary);
  }

  [data-theme="dark"] .hero__headline-accent {
    color: #60a5fa;
  }

  .hero__subheadline {
    margin: 0;
    max-width: 38rem;
    margin-inline: auto;
    font-size: clamp(var(--text-base), 2.2vw, var(--text-xl));
    line-height: var(--leading-relaxed);
    color: var(--color-gray-600);
  }

  [data-theme="dark"] .hero__subheadline {
    color: var(--color-gray-300);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    width: 100%;
  }

  .hero__cta-primary,
  .hero__cta-secondary {
    min-width: min(100%, 14rem);
  }

  .hero__trust-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4) var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hero__trust-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-gray-600);
    font-weight: var(--font-medium);
  }

  [data-theme="dark"] .hero__trust-item {
    color: var(--color-gray-300);
  }

  .hero__trust-icon {
    width: 1.125rem;
    height: 1.125rem;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  /* Background */
  .hero-background {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-background__mesh {
    position: absolute;
    inset: -20%;
    background:
      radial-gradient(circle at 20% 20%, rgba(37, 99, 235, 0.14), transparent 42%),
      radial-gradient(circle at 80% 10%, rgba(34, 197, 94, 0.1), transparent 38%),
      radial-gradient(circle at 50% 80%, rgba(59, 130, 246, 0.08), transparent 45%);
    animation: hero-mesh-drift 18s ease-in-out infinite alternate;
  }

  [data-theme="dark"] .hero-background__mesh {
    background:
      radial-gradient(circle at 20% 20%, rgba(59, 130, 246, 0.18), transparent 42%),
      radial-gradient(circle at 80% 10%, rgba(34, 197, 94, 0.12), transparent 38%),
      radial-gradient(circle at 50% 80%, rgba(37, 99, 235, 0.1), transparent 45%);
  }

  .hero-background__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(37, 99, 235, 0.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(37, 99, 235, 0.06) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, black 20%, transparent 75%);
    animation: hero-grid-pulse 8s ease-in-out infinite;
  }

  [data-theme="dark"] .hero-background__grid {
    background-image:
      linear-gradient(to right, rgba(147, 197, 253, 0.08) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(147, 197, 253, 0.08) 1px, transparent 1px);
  }

  .hero-background__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.45;
  }

  .hero-background__glow--primary {
    width: 28rem;
    height: 28rem;
    top: 10%;
    inset-inline-start: 10%;
    background: rgba(37, 99, 235, 0.22);
  }

  .hero-background__glow--accent {
    width: 24rem;
    height: 24rem;
    bottom: 5%;
    inset-inline-end: 8%;
    background: rgba(34, 197, 94, 0.16);
  }

  /* Dashboard preview */
  .hero-dashboard {
    width: min(100%, 56rem);
    margin-inline: auto;
    perspective: 1200px;
    order: 2;
  }

  .hero-dashboard__frame {
    position: relative;
    transform-style: preserve-3d;
    transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
  }

  .hero__works-with {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2) var(--space-4);
    padding-block-start: var(--space-2);
  }

  .hero__works-with-label {
    margin: 0;
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gray-500);
  }

  .hero__works-with-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hero__works-with-item {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-full);
    background: var(--bg-primary);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-gray-700);
  }

  [data-theme="dark"] .hero__works-with-item {
    background: var(--bg-secondary);
  }

  .hero-dashboard__card {
    position: relative;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-primary);
    background: var(--bg-primary);
    box-shadow:
      var(--shadow-xl),
      0 0 0 1px rgba(255, 255, 255, 0.04) inset;
    overflow: hidden;
    transform: translate3d(var(--parallax-x, 0px), var(--parallax-y, 0px), 0);
    animation: hero-dashboard-float 6s ease-in-out infinite;
  }

  .hero-dashboard__shadow {
    position: absolute;
    inset-inline: 8%;
    bottom: -1.5rem;
    height: 3rem;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(15, 23, 42, 0.22), transparent 70%);
    filter: blur(12px);
    transform: translateZ(-40px);
  }

  [data-theme="dark"] .hero-dashboard__shadow {
    background: radial-gradient(ellipse, rgba(0, 0, 0, 0.45), transparent 70%);
  }

  [data-theme="dark"] .hero-dashboard__card {
    border-color: var(--border-secondary);
    box-shadow:
      0 25px 50px -12px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(255, 255, 255, 0.04) inset;
  }

  .hero-dashboard__browser-bar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border-primary);
    background: var(--bg-secondary);
  }

  .hero-dashboard__browser-bar span {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: var(--radius-full);
    background: var(--color-gray-300);
  }

  .hero-dashboard__browser-bar span:nth-child(1) {
    background: #ef4444;
  }

  .hero-dashboard__browser-bar span:nth-child(2) {
    background: #f59e0b;
  }

  .hero-dashboard__browser-bar span:nth-child(3) {
    background: #22c55e;
  }

  .hero-dashboard__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top center;
  }

  .hero-dashboard__float {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-primary);
    background: color-mix(in srgb, var(--bg-primary) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: var(--shadow-md);
    animation: hero-icon-float 4.5s ease-in-out infinite;
    z-index: 2;
  }

  [data-theme="dark"] .hero-dashboard__float {
    background: color-mix(in srgb, var(--bg-secondary) 85%, transparent);
    border-color: var(--border-secondary);
  }

  .hero-dashboard__float--top-start {
    top: 8%;
    inset-inline-start: -2%;
    animation-delay: 0s;
  }

  .hero-dashboard__float--top-end {
    top: 14%;
    inset-inline-end: -2%;
    animation-delay: -1.2s;
  }

  .hero-dashboard__float--bottom-start {
    bottom: 12%;
    inset-inline-start: 4%;
    animation-delay: -2.4s;
  }

  .hero-dashboard__float--bottom-end {
    bottom: 8%;
    inset-inline-end: 2%;
    animation-delay: -3.6s;
  }

  .hero-dashboard__float-emoji {
    font-size: 1.35rem;
    line-height: 1;
  }

  @keyframes hero-mesh-drift {
    from {
      transform: translate3d(-2%, -1%, 0) scale(1);
    }
    to {
      transform: translate3d(2%, 1%, 0) scale(1.04);
    }
  }

  @keyframes hero-grid-pulse {
    0%,
    100% {
      opacity: 0.55;
    }
    50% {
      opacity: 0.85;
    }
  }

  @keyframes hero-dashboard-float {
    0%,
    100% {
      transform: translate3d(var(--parallax-x, 0px), var(--parallax-y, 0px), 0);
    }
    50% {
      transform: translate3d(var(--parallax-x, 0px), calc(var(--parallax-y, 0px) - 10px), 0);
    }
  }

  @keyframes hero-icon-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  @media (min-width: 1024px) {
    .hero {
      padding-block:
        calc(env(safe-area-inset-top, 0px) + 7.5rem)
        var(--space-10);
    }

    .hero__container {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: var(--space-10);
      align-items: center;
    }

    .hero__content {
      align-items: flex-start;
      text-align: start;
      max-width: none;
      margin-inline: 0;
      order: 1;
    }

    .hero__badge {
      align-self: flex-start;
    }

    .hero__headline {
      text-align: start;
      font-size: clamp(var(--text-4xl), 3.2vw, var(--text-6xl));
    }

    .hero__headline-accent {
      margin-inline: 0;
    }

    .hero__subheadline {
      margin-inline: 0;
      text-align: start;
    }

    .hero__actions {
      justify-content: flex-start;
    }

    .hero__trust-list,
    .hero__works-with {
      justify-content: flex-start;
    }

    .hero-dashboard {
      width: 100%;
      max-width: none;
      margin-inline: 0;
      order: 2;
    }

    .hero-dashboard__float {
      width: 3.75rem;
      height: 3.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-background__mesh,
    .hero-background__grid,
    .hero-dashboard__card,
    .hero-dashboard__float {
      animation: none;
    }

    .hero-dashboard__frame {
      transform: none;
    }
  }
</style>
