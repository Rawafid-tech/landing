---
import { getImage } from "astro:assets";
import heroArLight from "../assets/hero/hero-ar-light.png";
import heroArDark from "../assets/hero/hero-ar-dark.png";
import heroEnLight from "../assets/hero/hero-en-light.png";
import heroEnDark from "../assets/hero/hero-en-dark.png";
import HeroBackground from "./react-bits/HeroBackground";
import HeroContent from "./react-bits/HeroContent";
import HeroDashboardPreview, { type HeroImageSource } from "./react-bits/HeroDashboardPreview";
import MouseParallax from "./react-bits/MouseParallax";
import { getTranslations, type Locale } from "../i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "ar";
const t = getTranslations(locale);
const hero = t.hero;

// Mock-ups of the real dashboard, generated by design/mockups/render.mjs
const heroSources = {
  ar: { light: heroArLight, dark: heroArDark },
  en: { light: heroEnLight, dark: heroEnDark },
}[locale];

const heroWidths = [640, 896] as const;
const heroImageSizes = "(max-width: 640px) 100vw, (max-width: 1024px) min(90vw, 896px), 896px";

async function buildHeroImage(src: ImageMetadata): Promise<HeroImageSource> {
  const aspectRatio = src.width / src.height;
  const [avifImages, webpImages] = await Promise.all(
    (["avif", "webp"] as const).map((format) =>
      Promise.all(
        heroWidths.map((width) =>
          getImage({
            src,
            width,
            height: Math.round(width / aspectRatio),
            format,
            quality: format === "avif" ? 62 : 80,
          }),
        ),
      ),
    ),
  );

  const toSrcSet = (images: typeof avifImages) =>
    images.map((image, index) => `${image.src} ${heroWidths[index]}w`).join(", ");
  const fallback = webpImages[webpImages.length - 1];

  return {
    avifSrcSet: toSrcSet(avifImages),
    webpSrcSet: toSrcSet(webpImages),
    fallbackSrc: fallback.src,
    fallbackWidth: fallback.attributes.width,
    fallbackHeight: fallback.attributes.height,
    sizes: heroImageSizes,
  };
}

const [heroLight, heroDark] = await Promise.all([
  buildHeroImage(heroSources.light),
  buildHeroImage(heroSources.dark),
]);
const heroImages = { light: heroLight, dark: heroDark };
---

<!-- Preload only the variant for the active theme (data-theme is set earlier by ThemeScript). -->
<script
  is:inline
  define:vars={{ heroImages, heroImageSizes }}
>
  var heroTheme = document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
  var heroPreload = document.createElement("link");
  heroPreload.rel = "preload";
  heroPreload.as = "image";
  heroPreload.type = "image/avif";
  heroPreload.setAttribute("imagesrcset", heroImages[heroTheme].avifSrcSet);
  heroPreload.setAttribute("imagesizes", heroImageSizes);
  heroPreload.setAttribute("fetchpriority", "high");
  document.head.appendChild(heroPreload);
</script>

<section
  id="hero"
  class="hero"
  aria-label={hero.ariaLabel}
>
  <MouseParallax client:idle targetId="hero" />
  <HeroBackground client:idle />

  <div class="hero__container container">
    <HeroContent
      client:idle
      badge={hero.badge}
      headlinePrefix={hero.headlinePrefix}
      rotatingWords={hero.rotatingWords}
      subheadline={hero.subheadline}
      ctaPrimary={hero.ctaPrimary}
      ctaPrimaryHref={hero.ctaPrimaryHref}
      ctaSecondary={hero.ctaSecondary}
      ctaSecondaryHref={hero.ctaSecondaryHref}
      trustBadges={hero.trustBadges}
    />

    <HeroDashboardPreview
      client:visible
      images={heroImages}
      imageAlt={hero.dashboardAlt}
      floatingIcons={hero.floatingIcons}
    />
  </div>
</section>

<style is:global>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block:
      calc(env(safe-area-inset-top, 0px) + 6.5rem)
      var(--space-8);
    min-height: min(100dvh, 56rem);
    display: flex;
    align-items: center;
  }

  .hero__content {
    will-change: transform;
  }

  .hero-dashboard__frame {
    will-change: transform;
  }

  .hero-background__mesh,
  .hero-background__grid,
  .hero-background__glow,
  .hero-dashboard__float {
    will-change: transform;
  }

  .hero--mouse-active .hero-background__mesh,
  .hero--mouse-active .hero-background__grid,
  .hero--mouse-active .hero-background__glow,
  .hero--mouse-active .hero-dashboard__float {
    animation: none;
  }

  .hero__container {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-12);
    align-items: center;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-6);
    max-width: 46rem;
    margin-inline: auto;
    order: 1;
  }

  .hero__badge {
    display: inline-flex;
  }

  .hero__badge-inner {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    border: 1px solid var(--color-primary-alpha-20);
    background: color-mix(in srgb, var(--color-primary) 8%, var(--bg-primary));
    color: var(--color-primary-dark);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    box-shadow: var(--shadow-sm);
  }

  [data-theme="dark"] .hero__badge-inner {
    color: var(--color-primary-light);
    background: color-mix(in srgb, var(--color-primary) 16%, var(--bg-primary));
    border-color: var(--color-primary-alpha-20);
  }

  .hero__headline {
    display: block;
    width: 100%;
    font-size: clamp(var(--text-3xl), 4.5vw, var(--text-5xl));
    font-weight: var(--font-bold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--color-gray-900);
  }

  [data-theme="dark"] .hero__headline {
    color: var(--color-gray-50);
  }

  .hero__headline-line {
    display: block;
  }

  .hero__headline-accent {
    display: block;
    margin-block-start: 0.15em;
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
    padding-inline-end: 0.15em;
    border-inline-end: 4px solid var(--color-primary);
  }

  .hero-rotating-text {
    display: inline-block;
    min-height: 1.15em;
    vertical-align: bottom;
  }

  .hero-rotating-text__word {
    display: inline-block;
    color: var(--color-primary);
  }

  [data-theme="dark"] .hero-rotating-text__word {
    color: #60a5fa;
  }

  [data-theme="dark"] .hero__headline-accent {
    border-inline-end-color: #60a5fa;
  }

  .hero__subheadline-wrap {
    width: 100%;
  }

  .hero__subheadline {
    margin: 0;
    max-width: 38rem;
    margin-inline: auto;
    font-size: clamp(var(--text-base), 2.2vw, var(--text-xl));
    line-height: var(--leading-relaxed);
    color: var(--color-gray-600);
  }

  [data-theme="dark"] .hero__subheadline {
    color: var(--color-gray-300);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    width: 100%;
  }

  .hero__cta-primary,
  .hero__cta-secondary {
    min-width: min(100%, 14rem);
    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base),
      background-color var(--transition-base),
      border-color var(--transition-base),
      color var(--transition-base);
  }

  .hero__cta-primary:hover,
  .hero__cta-secondary:hover {
    transform: translateY(-2px);
  }

  .hero__cta-primary:active,
  .hero__cta-secondary:active {
    transform: translateY(0);
  }

  .hero__cta-primary:hover {
    color: var(--color-white);
  }

  .hero__cta-secondary {
    background: #ffffff;
    color: #1e293b;
    border: 1px solid #cbd5e1;
  }

  .hero__cta-secondary:hover {
    background: #f8fafc;
    color: #0f172a;
    border-color: #94a3b8;
    box-shadow: var(--shadow-sm);
  }

  [data-theme="dark"] .hero__cta-secondary {
    background: #1e293b;
    color: #f8fafc;
    border-color: #475569;
  }

  [data-theme="dark"] .hero__cta-secondary:hover {
    background: #334155;
    color: #ffffff;
    border-color: #64748b;
    box-shadow: var(--shadow-md);
  }

  [data-theme="dark"] .hero__cta-secondary:focus-visible {
    color: #ffffff;
    outline: 2px solid #93c5fd;
    outline-offset: 2px;
  }

  .hero__trust-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4) var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hero__trust-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-gray-600);
    font-weight: var(--font-medium);
  }

  [data-theme="dark"] .hero__trust-item {
    color: var(--color-gray-300);
  }

  .hero__trust-icon {
    width: 1.125rem;
    height: 1.125rem;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  /* Background */
  .hero-background {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-background__mesh {
    position: absolute;
    inset: -20%;
    background:
      radial-gradient(circle at 20% 20%, rgba(37, 99, 235, 0.14), transparent 42%),
      radial-gradient(circle at 80% 10%, rgba(34, 197, 94, 0.1), transparent 38%),
      radial-gradient(circle at 50% 80%, rgba(59, 130, 246, 0.08), transparent 45%);
    animation: hero-mesh-drift 18s ease-in-out infinite alternate;
  }

  [data-theme="dark"] .hero-background__mesh {
    background:
      radial-gradient(circle at 20% 20%, rgba(59, 130, 246, 0.18), transparent 42%),
      radial-gradient(circle at 80% 10%, rgba(34, 197, 94, 0.12), transparent 38%),
      radial-gradient(circle at 50% 80%, rgba(37, 99, 235, 0.1), transparent 45%);
  }

  .hero-background__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(37, 99, 235, 0.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(37, 99, 235, 0.06) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, black 20%, transparent 75%);
    animation: hero-grid-pulse 8s ease-in-out infinite;
  }

  [data-theme="dark"] .hero-background__grid {
    background-image:
      linear-gradient(to right, rgba(147, 197, 253, 0.08) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(147, 197, 253, 0.08) 1px, transparent 1px);
  }

  .hero-background__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-background__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.45;
    animation: hero-glow-float 12s ease-in-out infinite;
  }

  .hero-background__glow--primary {
    width: 28rem;
    height: 28rem;
    top: 10%;
    inset-inline-start: 10%;
    background: rgba(37, 99, 235, 0.22);
  }

  .hero-background__glow--accent {
    width: 24rem;
    height: 24rem;
    bottom: 5%;
    inset-inline-end: 8%;
    background: rgba(34, 197, 94, 0.16);
    animation-delay: -4s;
  }

  /* Dashboard preview */
  .hero-dashboard {
    width: min(100%, 56rem);
    margin-inline: auto;
    perspective: 1200px;
    order: 2;
  }

  .hero-dashboard__frame {
    position: relative;
    transform-style: preserve-3d;
    transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
  }

  .hero-dashboard__card {
    position: relative;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-primary);
    background: var(--bg-primary);
    box-shadow:
      var(--shadow-xl),
      0 0 0 1px rgba(255, 255, 255, 0.04) inset;
    overflow: hidden;
    transform: translate3d(var(--parallax-x, 0px), var(--parallax-y, 0px), 0);
    animation: hero-dashboard-float 6s ease-in-out infinite;
  }

  .hero-dashboard__shadow {
    position: absolute;
    inset-inline: 8%;
    bottom: -1.5rem;
    height: 3rem;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(15, 23, 42, 0.22), transparent 70%);
    filter: blur(12px);
    transform: translateZ(-40px);
  }

  [data-theme="dark"] .hero-dashboard__shadow {
    background: radial-gradient(ellipse, rgba(0, 0, 0, 0.45), transparent 70%);
  }

  [data-theme="dark"] .hero-dashboard__card {
    border-color: var(--border-secondary);
    box-shadow:
      0 25px 50px -12px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(255, 255, 255, 0.04) inset;
  }

  .hero-dashboard__browser-bar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border-primary);
    background: var(--bg-secondary);
  }

  .hero-dashboard__browser-bar span {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: var(--radius-full);
    background: var(--color-gray-300);
  }

  .hero-dashboard__browser-bar span:nth-child(1) {
    background: #ef4444;
  }

  .hero-dashboard__browser-bar span:nth-child(2) {
    background: #f59e0b;
  }

  .hero-dashboard__browser-bar span:nth-child(3) {
    background: #22c55e;
  }

  .hero-dashboard__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top center;
  }

  .hero-dashboard__float {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-primary);
    background: color-mix(in srgb, var(--bg-primary) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: var(--shadow-md);
    animation: hero-icon-float 4.5s ease-in-out infinite;
    z-index: 2;
  }

  [data-theme="dark"] .hero-dashboard__float {
    background: color-mix(in srgb, var(--bg-secondary) 85%, transparent);
    border-color: var(--border-secondary);
  }

  .hero-dashboard__float--top-start {
    top: 8%;
    inset-inline-start: -2%;
    animation-delay: 0s;
  }

  .hero-dashboard__float--top-end {
    top: 14%;
    inset-inline-end: -2%;
    animation-delay: -1.2s;
  }

  .hero-dashboard__float--bottom-start {
    bottom: 12%;
    inset-inline-start: 4%;
    animation-delay: -2.4s;
  }

  .hero-dashboard__float--bottom-end {
    bottom: 8%;
    inset-inline-end: 2%;
    animation-delay: -3.6s;
  }

  .hero-dashboard__float-emoji {
    font-size: 1.35rem;
    line-height: 1;
  }

  @keyframes hero-mesh-drift {
    from {
      transform: translate3d(-2%, -1%, 0) scale(1);
    }
    to {
      transform: translate3d(2%, 1%, 0) scale(1.04);
    }
  }

  @keyframes hero-grid-pulse {
    0%,
    100% {
      opacity: 0.55;
    }
    50% {
      opacity: 0.85;
    }
  }

  @keyframes hero-glow-float {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(0, -24px, 0);
    }
  }

  @keyframes hero-dashboard-float {
    0%,
    100% {
      transform: translate3d(var(--parallax-x, 0px), var(--parallax-y, 0px), 0);
    }
    50% {
      transform: translate3d(var(--parallax-x, 0px), calc(var(--parallax-y, 0px) - 10px), 0);
    }
  }

  @keyframes hero-icon-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  @media (min-width: 1024px) {
    .hero {
      padding-block:
        calc(env(safe-area-inset-top, 0px) + 7.5rem)
        var(--space-10);
    }

    .hero__container {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: var(--space-10);
      align-items: center;
    }

    .hero__content {
      align-items: flex-start;
      text-align: start;
      max-width: none;
      margin-inline: 0;
      order: 1;
    }

    .hero__badge {
      align-self: flex-start;
    }

    .hero__headline {
      text-align: start;
      font-size: clamp(var(--text-4xl), 3.2vw, var(--text-6xl));
    }

    .hero__headline-accent {
      margin-inline: 0;
    }

    .hero__subheadline {
      margin-inline: 0;
      text-align: start;
    }

    .hero__actions {
      justify-content: flex-start;
    }

    .hero__trust-list {
      justify-content: flex-start;
    }

    .hero-dashboard {
      width: 100%;
      max-width: none;
      margin-inline: 0;
      order: 2;
    }

    .hero-dashboard__float {
      width: 3.75rem;
      height: 3.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-background__mesh,
    .hero-background__grid,
    .hero-background__glow,
    .hero-dashboard__frame,
    .hero-dashboard__float {
      animation: none;
    }

    .hero__content,
    .hero-dashboard__frame {
      will-change: auto;
    }

    .hero-dashboard__frame {
      transform: none;
    }

    .hero__cta-primary:hover,
    .hero__cta-secondary:hover {
      transform: none;
    }
  }
</style>
