---
import { getTranslations, type Locale } from "../i18n";
import { SIGNUP_URL, getContactHref } from "../config/site";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "ar";
const t = getTranslations(locale);
const { finalCtaSection: s } = t;
---

<section id="get-started" class="final-cta" aria-labelledby="final-cta-heading">
  <div class="container">
    <!-- Compact, centered, solid brand blue + white only. -->
    <div class="final-cta__panel" data-reveal>
      <h2 id="final-cta-heading" class="final-cta__headline">{s.headline}</h2>
      <p class="final-cta__subheadline">{s.subheadline}</p>

      <div class="final-cta__actions">
        <a href={SIGNUP_URL} class="btn final-cta__btn final-cta__btn--primary">{s.ctaPrimary}</a>
        <a href={getContactHref()} class="btn final-cta__btn final-cta__btn--secondary">{s.ctaSecondary}</a>
      </div>

      <ul class="final-cta__trust" role="list" aria-label={s.trustListAriaLabel}>
        {
          s.trustBadges.map((badge) => (
            <li class="final-cta__trust-item">
              <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="final-cta__trust-icon">
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"
                />
              </svg>
              <span>{badge}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style is:global>
  .final-cta {
    padding-block: var(--space-12);
    background: var(--bg-primary);
  }

  .final-cta__panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    max-width: 48rem;
    margin-inline: auto;
    padding: var(--space-10) var(--space-6);
    border-radius: var(--radius-2xl);
    background: var(--color-primary);
    text-align: center;
  }

  @media (min-width: 640px) {
    .final-cta__panel {
      padding: var(--space-12) var(--space-10);
    }
  }

  .final-cta__headline {
    font-size: clamp(var(--text-2xl), 3vw, var(--text-4xl));
    font-weight: var(--font-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: #ffffff;
    text-wrap: balance;
  }

  .final-cta__subheadline {
    max-width: 34rem;
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: rgb(255 255 255 / 0.88);
    text-wrap: pretty;
  }

  .final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-block-start: var(--space-2);
  }

  .final-cta__trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-5);
    margin-block-start: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .final-cta__trust-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: rgb(255 255 255 / 0.9);
  }

  .final-cta__trust-icon {
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    color: #ffffff;
  }

  /* Built on the shared .btn (transition, lift, press). `.btn.` prefix beats the shared
     rules regardless of stylesheet order. */
  .btn.final-cta__btn {
    min-width: 10rem;
    min-height: 3rem;
  }

  .btn.final-cta__btn:focus-visible {
    outline-color: #ffffff;
  }

  .btn.final-cta__btn--primary {
    background: #ffffff;
    color: var(--color-primary-dark);
    box-shadow: 0 4px 12px -4px rgb(15 23 42 / 0.35);
  }

  .btn.final-cta__btn--primary:hover {
    background: #eff6ff;
    color: var(--color-primary-dark);
    box-shadow: 0 10px 20px -8px rgb(15 23 42 / 0.4);
  }

  .btn.final-cta__btn--secondary {
    background: transparent;
    color: #ffffff;
    border-color: rgb(255 255 255 / 0.6);
    box-shadow: none;
  }

  .btn.final-cta__btn--secondary:hover {
    background: rgb(255 255 255 / 0.1);
    color: #ffffff;
    border-color: #ffffff;
  }

  @media (max-width: 480px) {
    .final-cta__actions {
      flex-direction: column;
      align-self: stretch;
    }
  }
</style>
