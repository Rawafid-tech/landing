---
import FinalCtaSectionContent from "./react-bits/FinalCtaSectionContent";
import { getTranslations, type Locale } from "../i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "ar";
const t = getTranslations(locale);
const { finalCtaSection: s } = t;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPageElement",
  name: `${s.icon} ${s.headline}`,
  description: s.subheadline,
  potentialAction: [
    {
      "@type": "RegisterAction",
      name: s.ctaPrimary,
      target: s.ctaPrimaryHref,
    },
    {
      "@type": "CommunicateAction",
      name: s.ctaSecondary,
      target: s.ctaSecondaryHref,
    },
  ],
};
---

<section
  id="cta"
  class="final-cta-section"
  aria-label={s.ariaLabel}
>
  <div class="final-cta-section__ambient final-cta-section__ambient--start" aria-hidden="true"></div>
  <div class="final-cta-section__ambient final-cta-section__ambient--end" aria-hidden="true"></div>

  <div class="container final-cta-section__container">
    <FinalCtaSectionContent
      client:load
      icon={s.icon}
      headline={s.headline}
      subheadline={s.subheadline}
      ctaPrimary={s.ctaPrimary}
      ctaPrimaryHref={s.ctaPrimaryHref}
      ctaPrimaryAriaLabel={s.ctaPrimaryAriaLabel}
      ctaSecondary={s.ctaSecondary}
      ctaSecondaryHref={s.ctaSecondaryHref}
      ctaSecondaryAriaLabel={s.ctaSecondaryAriaLabel}
      trustBadges={s.trustBadges}
      trustListAriaLabel={s.trustListAriaLabel}
    />
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

<style is:global>
  /* ── Section shell ─────────────────────────────────────────── */
  .final-cta-section {
    position: relative;
    isolation: isolate;
    padding-block: var(--space-12) var(--space-16);
    background: var(--bg-secondary);
    overflow: hidden;
  }

  [data-theme="dark"] .final-cta-section {
    background: var(--bg-primary);
  }

  @media (min-width: 1024px) {
    .final-cta-section {
      padding-block: var(--space-16) var(--space-20);
    }
  }

  .final-cta-section__container {
    position: relative;
    z-index: 1;
  }

  .final-cta-section__inner {
    max-width: 56rem;
    margin-inline: auto;
  }

  /* ── Section ambient glows ─────────────────────────────────── */
  .final-cta-section__ambient {
    position: absolute;
    width: min(32rem, 58vw);
    height: min(32rem, 58vw);
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.2;
    pointer-events: none;
  }

  .final-cta-section__ambient--start {
    top: -18%;
    inset-inline-start: -14%;
    background: color-mix(in srgb, var(--color-primary) 24%, transparent);
  }

  .final-cta-section__ambient--end {
    bottom: -18%;
    inset-inline-end: -12%;
    background: color-mix(in srgb, #7c3aed 18%, transparent);
  }

  [data-theme="dark"] .final-cta-section__ambient {
    opacity: 0.1;
  }

  /* ── Panel ─────────────────────────────────────────────────── */
  .final-cta-section__panel {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-2xl);
    border: 1px solid color-mix(in srgb, #ffffff 18%, transparent);
    background: linear-gradient(
      145deg,
      var(--color-primary) 0%,
      #4338ca 46%,
      #6d28d9 100%
    );
    box-shadow:
      var(--shadow-xl),
      0 0 0 1px color-mix(in srgb, var(--color-primary) 14%, transparent),
      0 28px 80px color-mix(in srgb, var(--color-primary) 28%, transparent);
  }

  .final-cta-section__panel::before {
    content: "";
    position: absolute;
    top: 0;
    inset-inline: 0;
    height: 4px;
    border-radius: var(--radius-full) var(--radius-full) 0 0;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.15),
      rgba(255, 255, 255, 0.85),
      rgba(255, 255, 255, 0.15)
    );
    z-index: 2;
  }

  [data-theme="dark"] .final-cta-section__panel {
    border-color: color-mix(in srgb, #ffffff 12%, transparent);
    box-shadow:
      var(--shadow-xl),
      0 0 0 1px color-mix(in srgb, var(--color-primary-light) 12%, transparent),
      0 28px 90px color-mix(in srgb, #4338ca 35%, transparent);
  }

  /* ── Backdrop layers ───────────────────────────────────────── */
  .final-cta-section__backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .final-cta-section__mesh {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 18% 22%, rgba(255, 255, 255, 0.16), transparent 42%),
      radial-gradient(circle at 82% 78%, rgba(167, 139, 250, 0.22), transparent 44%);
    opacity: 0.9;
  }

  .final-cta-section__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: radial-gradient(circle at center, black 30%, transparent 88%);
    opacity: 0.55;
  }

  .final-cta-section__glow {
    position: absolute;
    width: min(22rem, 55%);
    height: min(22rem, 55%);
    border-radius: 50%;
    filter: blur(64px);
    opacity: 0.45;
  }

  .final-cta-section__glow--start {
    top: -20%;
    inset-inline-start: -12%;
    background: rgba(96, 165, 250, 0.55);
  }

  .final-cta-section__glow--end {
    bottom: -24%;
    inset-inline-end: -10%;
    background: rgba(167, 139, 250, 0.5);
  }

  /* ── Content ───────────────────────────────────────────────── */
  .final-cta-section__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
    padding: var(--space-10) var(--space-6);
    text-align: center;
  }

  @media (min-width: 640px) {
    .final-cta-section__content {
      padding: var(--space-12) var(--space-10);
      gap: var(--space-10);
    }
  }

  @media (min-width: 1024px) {
    .final-cta-section__content {
      padding: var(--space-16) var(--space-12);
    }
  }

  .final-cta-section__heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    max-width: 36rem;
  }

  .final-cta-section__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.22);
    font-size: 1.625rem;
    line-height: 1;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.25),
      0 8px 24px rgba(15, 23, 42, 0.18);
  }

  .final-cta-section__headline {
    margin: 0;
    font-size: clamp(var(--text-3xl), 4.5vw, var(--text-5xl));
    font-weight: var(--font-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: #ffffff;
    text-wrap: balance;
  }

  .final-cta-section__subheadline {
    margin: 0;
    max-width: 34rem;
    font-size: clamp(var(--text-base), 2.1vw, var(--text-xl));
    line-height: var(--leading-relaxed);
    color: rgba(219, 234, 254, 0.92);
    text-wrap: pretty;
  }

  /* ── Actions ─────────────────────────────────────────────────── */
  .final-cta-section__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-4);
    width: 100%;
    max-width: 36rem;
  }

  .final-cta-section__action {
    flex: 1 1 100%;
    display: flex;
    justify-content: center;
  }

  @media (min-width: 640px) {
    .final-cta-section__action {
      flex: 0 1 auto;
    }
  }

  .final-cta-section__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: min(100%, 14rem);
    min-height: 3.25rem;
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-lg);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base),
      background-color var(--transition-base),
      border-color var(--transition-base),
      color var(--transition-base);
  }

  @media (min-width: 640px) {
    .final-cta-section__btn {
      font-size: var(--text-lg);
    }
  }

  .final-cta-section__btn:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  .final-cta-section__btn--primary {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: linear-gradient(180deg, #ffffff 0%, #eef2ff 100%);
    color: var(--color-primary-dark);
    border: 1px solid rgba(255, 255, 255, 0.65);
    box-shadow:
      0 12px 32px rgba(15, 23, 42, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.85);
  }

  .final-cta-section__btn--primary::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 35%,
      rgba(255, 255, 255, 0.55) 50%,
      transparent 65%
    );
    transform: translateX(-120%);
    transition: transform 0.65s ease;
    pointer-events: none;
  }

  .final-cta-section__btn--primary:hover,
  .final-cta-section__btn--primary:focus-visible {
    color: var(--color-primary-dark);
    transform: translateY(-2px);
    box-shadow:
      0 18px 40px rgba(15, 23, 42, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.95);
  }

  .final-cta-section__btn--primary:hover::after,
  .final-cta-section__btn--primary:focus-visible::after {
    transform: translateX(120%);
  }

  .final-cta-section__btn--secondary {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.34);
    backdrop-filter: blur(8px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }

  .final-cta-section__btn--secondary:hover,
  .final-cta-section__btn--secondary:focus-visible {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.48);
    transform: translateY(-2px);
    box-shadow:
      0 12px 28px rgba(15, 23, 42, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
  }

  /* ── Trust badges ──────────────────────────────────────────── */
  .final-cta-section__trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3) var(--space-6);
    list-style: none;
    margin: 0;
    padding: var(--space-5) var(--space-4) 0;
    width: 100%;
    max-width: 40rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  @media (min-width: 640px) {
    .final-cta-section__trust {
      padding-top: var(--space-6);
    }
  }

  .final-cta-section__trust-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: rgba(239, 246, 255, 0.92);
  }

  @media (min-width: 640px) {
    .final-cta-section__trust-item {
      font-size: var(--text-base);
    }
  }

  .final-cta-section__trust-icon {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
    color: #86efac;
  }

  @media (prefers-reduced-motion: reduce) {
    .final-cta-section__btn,
    .final-cta-section__btn--primary::after {
      transition: none;
    }

    .final-cta-section__btn--primary::after {
      display: none;
    }

    .final-cta-section__btn--primary:hover,
    .final-cta-section__btn--primary:focus-visible,
    .final-cta-section__btn--secondary:hover,
    .final-cta-section__btn--secondary:focus-visible {
      transform: none;
    }
  }
</style>
